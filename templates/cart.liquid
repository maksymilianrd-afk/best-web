<div class="cart-page">
  <div class="container">
    <h1>Your Cart</h1>

    {%- if cart.item_count > 0 -%}

      <form action="{{ routes.cart_url }}" method="post">
        <table class="cart-table" aria-label="Cart contents">
          <thead>
            <tr>
              <th colspan="2">Product</th>
              <th>Quantity</th>
              <th>Price</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td style="width:80px;padding-right:16px;">
                  <div class="cart-item-img">
                    <a href="{{ item.url }}">
                      {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.title }}
                    </a>
                  </div>
                </td>
                <td>
                  <a href="{{ item.url }}" style="font-weight:600;text-decoration:none;color:var(--charcoal);">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <p style="font-size:0.875rem;color:var(--clay);margin-top:4px;">{{ item.variant.title }}</p>
                  {%- endunless -%}
                </td>
                <td>
                  <div class="qty-wrap" style="display:flex;align-items:center;gap:8px;">
                    <button class="qty-btn" data-dir="down" type="button" style="width:32px;height:32px;border:1px solid rgba(43,39,34,.15);border-radius:6px;background:none;cursor:pointer;font-size:1.125rem;color:var(--charcoal);">-</button>
                    <input class="qty-input" type="number" name="updates[]" value="{{ item.quantity }}" min="1" style="width:48px;text-align:center;border:1px solid rgba(43,39,34,.15);border-radius:6px;padding:6px;font-size:0.9375rem;color:var(--charcoal);background:none;">
                    <button class="qty-btn" data-dir="up" type="button" style="width:32px;height:32px;border:1px solid rgba(43,39,34,.15);border-radius:6px;background:none;cursor:pointer;font-size:1.125rem;color:var(--charcoal);">+</button>
                  </div>
                </td>
                <td style="font-weight:600;">{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-totals">
          <div class="cart-total-row">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <div class="cart-total-row" style="font-size:0.875rem;color:var(--clay);">
            <span>Shipping</span>
            <span>Free</span>
          </div>
          <div class="cart-total-row grand-total">
            <span>Total</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <div style="display:flex;gap:12px;margin-top:24px;flex-direction:column;">
            <button type="submit" name="update" class="btn btn--ghost btn--full">Update Cart</button>
            <a href="{{ routes.checkout }}" class="btn btn--primary btn--full btn--lg">
              Checkout — {{ cart.total_price | money }}
            </a>
          </div>

          <p style="font-size:0.8125rem;color:var(--clay);text-align:center;margin-top:16px;">
            🔒 Secure checkout &nbsp;·&nbsp; 30-day guarantee
          </p>
        </div>
      </form>

    {%- else -%}
      <div class="cart-empty">
        <p>Your cart is empty — your cat is waiting for their new spot.</p>
        <a href="{{ routes.root_url }}" class="btn btn--primary btn--lg">Shop DeskPaws</a>
      </div>
    {%- endif -%}
  </div>
</div>
