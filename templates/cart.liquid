<div class="cp-wrap">

  {%- if cart.item_count > 0 -%}

    <div class="cp-layout">

      <!-- LEFT: items + brand moment -->
      <div class="cp-lhs">

        <p class="cp-heading">Your cart</p>

        {%- for item in cart.items -%}
          <div class="cp-item">
            <div class="cp-item__img">
              {%- if item.image -%}
                <a href="{{ item.url }}">
                  {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.title, class: 'cp-item__photo' }}
                </a>
              {%- else -%}
                <div class="cp-item__img-empty"></div>
              {%- endif -%}
            </div>
            <div class="cp-item__info">
              <a href="{{ item.url }}" class="cp-item__name">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cp-item__sub">{{ item.variant.title }}</p>
              {%- endunless -%}
              <div class="cp-item__qty" data-key="{{ item.key }}">
                <button class="cqty-btn" type="button" data-dir="down" aria-label="Decrease quantity">−</button>
                <span class="cqty-num">{{ item.quantity }}</span>
                <button class="cqty-btn" type="button" data-dir="up" aria-label="Increase quantity">+</button>
              </div>
            </div>
            <span class="cp-item__price" data-line-price="{{ item.final_line_price }}">
              {{- item.final_line_price | money_without_trailing_zeros -}}
            </span>
          </div>
        {%- endfor -%}

        <!-- Brand moment -->
        <div class="cp-brand">
          <span class="cp-brand__label">Almost there</span>
          <p class="cp-brand__quote">&ldquo;She was in it before my coffee was ready.&rdquo;</p>
          <div class="cp-brand__steps">
            <div class="cp-brand__step">
              <span class="cp-brand__num">01</span>
              <p class="cp-brand__text">Order today — ships within 1–2 business days</p>
            </div>
            <div class="cp-brand__step">
              <span class="cp-brand__num">02</span>
              <p class="cp-brand__text">Clamp it on in 60 seconds — no tools needed</p>
            </div>
            <div class="cp-brand__step">
              <span class="cp-brand__num">03</span>
              <p class="cp-brand__text">Watch your cat claim it. Keyboard yours again.</p>
            </div>
          </div>
        </div>

      </div><!-- /.cp-lhs -->

      <!-- RIGHT: order summary -->
      <div class="cp-rhs">

        <p class="cp-rhs__title">Order summary</p>

        {%- for item in cart.items -%}
          <div class="cp-sum__row">
            <span class="cp-sum__label">
              {{- item.product.title -}}
              {%- unless item.product.has_only_default_variant -%}
                &nbsp;&middot;&nbsp;{{ item.variant.title }}
              {%- endunless -%}
              &nbsp;&times;&nbsp;{{ item.quantity }}
            </span>
            <span class="cp-sum__val">{{ item.final_line_price | money_without_trailing_zeros }}</span>
          </div>
        {%- endfor -%}

        <div class="cp-sum__row">
          <span class="cp-sum__label">Shipping</span>
          <span class="cp-sum__free">Free</span>
        </div>

        <div class="cp-sum__rule"></div>

        <div class="cp-sum__total-row">
          <span class="cp-sum__total-label">Total</span>
          <span class="cp-sum__total-val" id="cp-total">
            {{- cart.total_price | money_without_trailing_zeros -}}
          </span>
        </div>

        <div class="cp-sum__rule"></div>

        <a href="{{ routes.checkout }}" class="cp-checkout-btn">
          Checkout &mdash; {{ cart.total_price | money_without_trailing_zeros }} &rarr;
        </a>

        <div class="cp-trust-mini">
          <span>Secure checkout</span>
          <span class="cp-trust-dot">&middot;</span>
          <span>Free shipping</span>
          <span class="cp-trust-dot">&middot;</span>
          <span>30-day returns</span>
        </div>

        <a href="{{ routes.root_url }}" class="cp-continue">&larr; Continue shopping</a>

      </div><!-- /.cp-rhs -->

    </div><!-- /.cp-layout -->

  {%- else -%}

    <div class="cp-empty">
      <p class="cp-empty__text">Your cart is empty &mdash; your cat is waiting for their new spot.</p>
      <a href="{{ routes.root_url }}" class="btn btn--primary btn--lg">Shop DeskPaws</a>
    </div>

  {%- endif -%}

</div>
