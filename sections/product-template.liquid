{%- assign current_product = product -%}
{%- assign current_variant = current_product.selected_or_first_available_variant -%}

<div class="pdp">

  <!-- Breadcrumb -->
  <nav class="pdp__breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}" class="pdp__breadcrumb-link">
      <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M1 5h12M1 5l4-4M1 5l4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Back to home
    </a>
  </nav>

  <div class="pdp__inner">
    <div class="pdp__layout">

      <!-- ── Gallery ── -->
      <div class="pdp__gallery">

        <!-- Thumbnail strip (left at desktop, bottom at mobile) -->
        <div class="pdp__thumbs" id="pdp-thumbs">
          {%- if current_product.images.size > 0 -%}
            {%- for image in current_product.images limit: 6 -%}
              <button
                class="pdp__thumb{% if forloop.first %} active{% endif %}"
                data-target="pdp-main-img"
                data-src="{{ image | image_url: width: 1000 }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: current_product.title }}" loading="lazy" width="160" height="160">
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- assign fallbacks = 'product-on-desk.png,hero-desk.png,cat-curled.png,clamp-detail.jpeg' | split: ',' -%}
            {%- for img_name in fallbacks -%}
              <button class="pdp__thumb{% if forloop.first %} active{% endif %}" data-target="pdp-main-img" data-src="{{ img_name | asset_url }}" aria-label="View {{ forloop.index }}">
                <img src="{{ img_name | asset_url }}" alt="DeskPaws view {{ forloop.index }}" loading="lazy" width="160" height="160">
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <!-- Main image -->
        <div class="pdp__main-image">
          {%- if current_product.featured_image -%}
            <img
              id="pdp-main-img"
              src="{{ current_product.featured_image | image_url: width: 1000 }}"
              alt="{{ current_product.featured_image.alt | default: current_product.title }}"
              width="1000"
              height="1250"
              loading="eager"
              fetchpriority="high"
            >
          {%- else -%}
            <img
              id="pdp-main-img"
              src="{{ 'product-on-desk.png' | asset_url }}"
              alt="{{ current_product.title | default: 'DeskPaws' }}"
              width="1000"
              height="1250"
              loading="eager"
              fetchpriority="high"
            >
          {%- endif -%}
        </div>

      </div>

      <!-- ── Product Info ── -->
      <div class="pdp__info">

        <div class="pdp__info-inner">

          <p class="pdp__eyebrow">The desk bed your cat will actually use</p>

          <h1 class="pdp__title">
            {{ current_product.title | default: "DeskPaws &mdash; Clamp-On Desk Cat Bed" }}
          </h1>

          <!-- Stars -->
          <div class="pdp__stars" aria-label="4.9 out of 5 stars">
            <span class="pdp__stars-icons" aria-hidden="true">★★★★★</span>
            <span class="pdp__stars-count">4.9 &nbsp;·&nbsp; 243 reviews</span>
          </div>

          <!-- Price -->
          <div class="pdp__price-row">
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <s class="pdp__compare-price">{{ current_variant.compare_at_price | money }}</s>
            {%- endif -%}
            <span class="pdp__price" id="product-price">{{ current_variant.price | money }}</span>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="pdp__badge">Sale</span>
            {%- endif -%}
          </div>

          <p class="pdp__desc">
            {{ section.settings.short_description | default: "Your cat is going to sit on your desk anyway. Give them a better spot — right next to you, without taking over your keyboard." }}
          </p>

          <!-- Benefits -->
          <ul class="pdp__benefits">
            <li><span class="pdp__check">✓</span><span><strong>Stays close, out of your way</strong> — close enough to pet between emails, out of the keyboard zone.</span></li>
            <li><span class="pdp__check">✓</span><span><strong>Your cat will actually use it</strong> — deep nest shape. Most claim it within 24 hours.</span></li>
            <li><span class="pdp__check">✓</span><span><strong>Clamps on in 60 seconds</strong> — no tools, no drilling. Padded clamp protects your desk.</span></li>
            <li><span class="pdp__check">✓</span><span><strong>50 lb rated metal frame</strong> — hand-washable sherpa cushion included.</span></li>
          </ul>

          <!-- Form -->
          {%- form 'product', current_product, class: 'pdp__form', id: 'product-form' -%}

            {%- if current_product.variants.size > 1 -%}
              <div class="variant-wrap">
                <label class="variant-label" for="variant-select">{{ current_product.options.first }}</label>
                <select id="variant-select" name="id" class="variant-select" aria-label="Select variant">
                  {%- for variant in current_product.variants -%}
                    <option
                      value="{{ variant.id }}"
                      {%- if variant == current_variant %} selected{%- endif -%}
                      {%- unless variant.available %} disabled{%- endunless -%}
                      data-price="{{ variant.price | money }}"
                      data-compare-price="{{ variant.compare_at_price | money }}"
                    >
                      {{ variant.title }}{%- unless variant.available %} — Sold out{%- endunless -%}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- else -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
            {%- endif -%}

            <div class="pdp__actions">
              <button
                type="submit"
                class="btn-butter pdp__atc"
                id="atc-btn"
                {%- unless current_product.available -%}disabled{%- endunless -%}
              >
                {%- if current_product.available -%}
                  Add to Cart — {{ current_variant.price | money }}
                  <span class="btn-butter__arr" aria-hidden="true">→</span>
                {%- else -%}
                  Sold Out
                {%- endif -%}
              </button>

              {%- if current_product.available -%}
                <a href="/checkout?variant={{ current_variant.id }}&quantity=1" class="btn-checkout" id="checkout-btn">
                  Buy it now
                </a>
              {%- endif -%}
            </div>

          {%- endform -%}

          <!-- Trust bar -->
          <div class="pdp__trust">
            <div class="pdp__trust-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>30-Day Guarantee</span>
            </div>
            <div class="pdp__trust-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>Free Shipping</span>
            </div>
            <div class="pdp__trust-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <span>Ships in 1–2 Days</span>
            </div>
          </div>

          <!-- Accordion -->
          <div class="pdp__accordion faq-list">

            <div class="faq-item">
              <button class="faq-item__trigger" aria-expanded="false">
                <span class="faq-item__question">Product details &amp; specs</span>
                <span class="faq-item__icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="6" y1="1" x2="6" y2="11"/><line x1="1" y1="6" x2="11" y2="6"/></svg>
                </span>
              </button>
              <div class="faq-item__answer">
                <p class="faq-item__body">
                  Diameter: 39 cm / 15.4″ &nbsp;·&nbsp;
                  Material: premium faux-sherpa &nbsp;·&nbsp;
                  Frame: powder-coated iron &nbsp;·&nbsp;
                  Weight capacity: 50 lbs / 23 kg &nbsp;·&nbsp;
                  Clamp range: up to ~5 cm / 2″ edge &nbsp;·&nbsp;
                  Colour: cream/white &nbsp;·&nbsp;
                  Cushion: hand-washable, air dry
                </p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-item__trigger" aria-expanded="false">
                <span class="faq-item__question">Shipping &amp; delivery</span>
                <span class="faq-item__icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="6" y1="1" x2="6" y2="11"/><line x1="1" y1="6" x2="11" y2="6"/></svg>
                </span>
              </button>
              <div class="faq-item__answer">
                <p class="faq-item__body">Free shipping to the US, Canada, and UK. Orders ship within 1–2 business days. Estimated delivery: 8–12 days to the US. Tracking number sent by email on shipment day.</p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-item__trigger" aria-expanded="false">
                <span class="faq-item__question">Returns &amp; our guarantee</span>
                <span class="faq-item__icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="6" y1="1" x2="6" y2="11"/><line x1="1" y1="6" x2="11" y2="6"/></svg>
                </span>
              </button>
              <div class="faq-item__answer">
                <p class="faq-item__body">30-day satisfaction guarantee. If your cat snubs it, email <a href="mailto:hello@deskpaws.com">hello@deskpaws.com</a> for a full refund — you keep the bed.</p>
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Page",
  "tag": "div",
  "settings": [
    {
      "type": "textarea",
      "id": "short_description",
      "label": "Short description",
      "default": "Your cat is going to sit on your desk anyway. Give them a better spot — right next to you, without taking over your keyboard."
    }
  ]
}
{% endschema %}
