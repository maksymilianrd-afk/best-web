{%- assign current_product = product -%}
{%- assign current_variant = current_product.selected_or_first_available_variant -%}

<div class="pdp">

  <!-- Breadcrumb -->
  <nav class="pdp__breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}" class="pdp__bc-link">Home</a>
    <span class="pdp__bc-sep" aria-hidden="true">/</span>
    <a href="{{ routes.root_url }}collections/all" class="pdp__bc-link">Shop</a>
    <span class="pdp__bc-sep" aria-hidden="true">/</span>
    <span class="pdp__bc-current">{{ current_product.title | default: "DeskPaws" }}</span>
  </nav>

  <div class="pdp__inner">
    <div class="pdp__layout">

      <!-- ── Left: Gallery ── -->
      <div class="pdp__gallery">

        <!-- Main image -->
        <div class="pdp__main-image">
          {%- if current_product.featured_image -%}
            <img
              id="pdp-main-img"
              src="{{ current_product.featured_image | image_url: width: 1200 }}"
              alt="{{ current_product.featured_image.alt | default: current_product.title }}"
              width="1200" height="1500"
              loading="eager"
              fetchpriority="high"
            >
          {%- else -%}
            <img
              id="pdp-main-img"
              src="{{ 'product-on-desk.png' | asset_url }}"
              alt="{{ current_product.title | default: 'DeskPaws' }}"
              width="1200" height="1500"
              loading="eager"
              fetchpriority="high"
            >
          {%- endif -%}
        </div>

        <!-- Thumbnail strip -->
        <div class="pdp__thumb-row">
          <button class="pdp__thumb-arrow" id="pdp-thumb-prev" aria-label="Previous images">
            <svg width="8" height="14" viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 1L1 7l6 6"/></svg>
          </button>
          <div class="pdp__thumb-track" id="pdp-thumb-track">
            {%- if current_product.images.size > 0 -%}
              {%- for image in current_product.images limit: 12 -%}
                <button
                  class="pdp__thumb{% if forloop.first %} active{% endif %}"
                  data-target="pdp-main-img"
                  data-src="{{ image | image_url: width: 1200 }}"
                  aria-label="View image {{ forloop.index }}"
                >
                  <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: current_product.title }}" loading="lazy" width="160" height="160">
                </button>
              {%- endfor -%}
            {%- else -%}
              {%- assign fallbacks = 'product-on-desk.png,hero-desk.png,cat-curled.png,clamp-detail.jpeg' | split: ',' -%}
              {%- for img_name in fallbacks -%}
                <button class="pdp__thumb{% if forloop.first %} active{% endif %}" data-target="pdp-main-img" data-src="{{ img_name | asset_url }}" aria-label="View {{ forloop.index }}">
                  <img src="{{ img_name | asset_url }}" alt="DeskPaws" loading="lazy" width="160" height="160">
                </button>
              {%- endfor -%}
            {%- endif -%}
          </div>
          <button class="pdp__thumb-arrow" id="pdp-thumb-next" aria-label="Next images">
            <svg width="8" height="14" viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1l6 6-6 6"/></svg>
          </button>
        </div>

      </div>

      <!-- ── Right: Product info ── -->
      <div class="pdp__info">

        <h1 class="pdp__title">{{ current_product.title | default: "DeskPaws — Clamp-On Desk Cat Bed" }}</h1>

        {%- if current_product.variants.size > 1 -%}
          <p class="pdp__variant-subtitle" id="pdp-variant-name">{{ current_variant.title }}</p>
        {%- endif -%}

        <div class="pdp__price-row">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s class="pdp__compare-price">{{ current_variant.compare_at_price | money }}</s>
          {%- endif -%}
          <span class="pdp__price" id="product-price">{{ current_variant.price | money }}</span>
        </div>

        <div class="pdp__stars">
          <span class="pdp__stars-icons" aria-hidden="true">★★★★★</span>
          <a class="pdp__stars-count" href="#customer-reviews">Read customer reviews</a>
        </div>

        <hr class="pdp__divider">

        <!-- Variant tiles -->
        {%- if current_product.variants.size > 1 -%}
          <div class="pdp__variants" role="group" aria-label="Select {{ current_product.options.first }}">
            {%- for variant in current_product.variants -%}
              <button
                class="pdp__variant-tile{% if variant == current_variant %} active{% endif %}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price | money }}"
                data-compare-price="{{ variant.compare_at_price | money }}"
                data-variant-name="{{ variant.title }}"
                {%- if variant.featured_image %}data-image-src="{{ variant.featured_image | image_url: width: 1200 }}"{%- endif -%}
                {%- unless variant.available %}disabled aria-disabled="true"{%- endunless -%}
                aria-label="Select {{ variant.title }}"
              >
                {%- if variant.featured_image -%}
                  <img src="{{ variant.featured_image | image_url: width: 200 }}" alt="{{ variant.title }}" loading="lazy" width="200" height="200">
                {%- else -%}
                  <span class="pdp__variant-tile-label">{{ variant.title }}</span>
                {%- endif -%}
                <span class="pdp__variant-tile-name">{{ variant.title }}</span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Form -->
        {%- form 'product', current_product, class: 'pdp__form', id: 'product-form' -%}

          {%- if current_product.variants.size > 1 -%}
            <input type="hidden" name="id" id="variant-id-input" value="{{ current_variant.id }}">
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {%- endif -%}

          <button
            type="submit"
            class="pdp__atc"
            id="atc-btn"
            {%- unless current_product.available -%}disabled{%- endunless -%}
          >
            {%- if current_product.available -%}
              Add to Cart &nbsp;&middot;&nbsp; <span id="pdp-atc-price">{{ current_variant.price | money }}</span>
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>

        {%- endform -%}

        {%- if current_product.available -%}
          <a href="/checkout?variant={{ current_variant.id }}&quantity=1" class="pdp__buynow" id="checkout-btn">
            Buy it now
          </a>
        {%- endif -%}

        <p class="pdp__shipping-note">
          Free shipping &nbsp;&middot;&nbsp; Ships in 1&ndash;2 business days
        </p>

        <hr class="pdp__divider">

        <!-- Description -->
        <div class="pdp__description">
          {%- if current_product.description != blank -%}
            {{ current_product.description }}
          {%- else -%}
            <p>{{ section.settings.short_description | default: "Your cat is going to sit on your desk anyway. Give them a better spot — right next to you, without taking over your keyboard. The DeskPaws clamp-on desk bed installs in 60 seconds, holds up to 50 lbs, and ships with a deep sherpa cushion your cat won't want to leave." }}</p>
          {%- endif -%}
        </div>

        <!-- Accordion -->
        <div class="pdp__accordion faq-list">

          <div class="faq-item">
            <button class="faq-item__trigger" aria-expanded="false">
              <span class="faq-item__question">Details</span>
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-item__answer">
              <p class="faq-item__body">
                Diameter: 39 cm / 15.4&Prime; &nbsp;&middot;&nbsp;
                Material: premium faux-sherpa &nbsp;&middot;&nbsp;
                Frame: powder-coated iron &nbsp;&middot;&nbsp;
                Weight capacity: 50 lbs / 23 kg &nbsp;&middot;&nbsp;
                Clamp range: desk edges up to 5 cm / 2&Prime; thick &nbsp;&middot;&nbsp;
                Colour: cream / white &nbsp;&middot;&nbsp;
                Cushion: hand-washable, air dry
              </p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-item__trigger" aria-expanded="false">
              <span class="faq-item__question">Shipping &amp; Returns</span>
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-item__answer">
              <p class="faq-item__body">
                Free shipping to the US and Canada. Orders ship within 1&ndash;2 business days. Estimated delivery: 7&ndash;14 business days to the US. Tracking number sent by email on shipment day.
                <br><br>
                30-day satisfaction guarantee. If your cat snubs it, email <a href="mailto:hello@deskpaws.com">hello@deskpaws.com</a> for a full refund &mdash; you keep the bed.
              </p>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>

</div>

{% schema %}
{
  "name": "Product Page",
  "tag": "div",
  "settings": [
    {
      "type": "textarea",
      "id": "short_description",
      "label": "Short description (used when product has no description in Shopify admin)",
      "default": "Your cat is going to sit on your desk anyway. Give them a better spot — right next to you, without taking over your keyboard."
    }
  ]
}
{% endschema %}
