{%- assign current_product = product -%}
{%- assign current_variant = current_product.selected_or_first_available_variant -%}

<div class="product-page">
  <div class="product-page__inner">
    <div class="product-layout">

      <!-- ── Image Gallery ── -->
      <div class="product-gallery-wrap">
        <div class="gallery-main" id="gallery-main">
          {%- if current_product.featured_image -%}
            <img
              id="main-product-img"
              src="{{ current_product.featured_image | image_url: width: 900 }}"
              alt="{{ current_product.featured_image.alt | default: current_product.title }}"
              width="900"
              height="900"
              loading="eager"
              fetchpriority="high"
            >
          {%- else -%}
            <img
              id="main-product-img"
              src="{{ 'product-on-desk.png' | asset_url }}"
              alt="{{ current_product.title }}"
              width="900"
              height="900"
              loading="eager"
              fetchpriority="high"
            >
          {%- endif -%}
        </div>

        <div class="gallery-thumbs">
          {%- if current_product.images.size > 0 -%}
            {%- for image in current_product.images limit: 8 -%}
              <button
                class="product-thumb{% if forloop.first %} active{% endif %}"
                data-src="{{ image | image_url: width: 900 }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 200 }}"
                  alt="{{ image.alt | default: current_product.title }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- assign fallback_images = 'hero-desk.png,cat-curled.png,product-floating.png,clamp-detail.jpeg' | split: ',' -%}
            {%- for img_name in fallback_images -%}
              <button class="product-thumb{% if forloop.first %} active{% endif %}" data-src="{{ img_name | asset_url }}" aria-label="Product view {{ forloop.index }}">
                <img src="{{ img_name | asset_url }}" alt="DeskPaws product view {{ forloop.index }}" loading="lazy" width="200" height="200">
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <!-- ── Product Info ── -->
      <div class="product-info-wrap">
        <div class="product-info">

          <p class="text-subtitle">The desk bed your cat will actually use</p>

          <h1 class="product-info__title">
            {{ current_product.title | default: "DeskPaws &mdash; Clamp-On Desk Cat Bed" }}
          </h1>

          <!-- Price -->
          <div class="product-price-row">
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <s class="product-price--compare">{{ current_variant.compare_at_price | money }}</s>
            {%- endif -%}
            <span class="product-price" id="product-price">{{ current_variant.price | money }}</span>
          </div>

          <p class="product-short-desc">
            {{ section.settings.short_description | default: "Your cat is going to sit on your desk anyway. Give them a better spot — right next to you, without taking over your keyboard." }}
          </p>

          <ul class="benefits-list">
            <li><span class="benefit-check">&#10003;</span><span><strong>Stays close, out of your way</strong> &mdash; close enough to pet between emails, out of the keyboard zone.</span></li>
            <li><span class="benefit-check">&#10003;</span><span><strong>Your cat will actually use it</strong> &mdash; deep nest shape is instinctively appealing. Most claim it within 24 hours.</span></li>
            <li><span class="benefit-check">&#10003;</span><span><strong>Clamps on in 60 seconds</strong> &mdash; no tools, no drilling. Padded G-clamp protects your desk surface.</span></li>
            <li><span class="benefit-check">&#10003;</span><span><strong>Built to last</strong> &mdash; solid metal frame, tested to 50 lbs, hand-washable sherpa cushion.</span></li>
            <li><span class="benefit-check">&#10003;</span><span><strong>Your keyboard is yours again</strong> &mdash; no more deleted drafts, accidental Slack messages, or muted calls.</span></li>
          </ul>

          <!-- Product form -->
          {%- form 'product', current_product, class: 'atc-form', id: 'product-form' -%}

            {%- if current_product.variants.size > 1 -%}
              <div class="variant-wrap">
                <label class="variant-label" for="variant-select">{{ current_product.options.first }}</label>
                <select
                  id="variant-select"
                  name="id"
                  class="variant-select"
                  aria-label="Select variant"
                >
                  {%- for variant in current_product.variants -%}
                    <option
                      value="{{ variant.id }}"
                      {%- if variant == current_variant %} selected{%- endif -%}
                      {%- unless variant.available %} disabled{%- endunless -%}
                      data-price="{{ variant.price | money }}"
                      data-compare-price="{{ variant.compare_at_price | money }}"
                    >
                      {{ variant.title }}{%- unless variant.available %} &mdash; Sold out{%- endunless -%}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- else -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
            {%- endif -%}

            <div class="atc-actions">
              <button
                type="submit"
                class="btn-butter atc-btn"
                id="atc-btn"
                {%- unless current_product.available -%}disabled{%- endunless -%}
              >
                {%- if current_product.available -%}
                  Add to Cart &mdash; {{ current_variant.price | money }}
                  <span class="btn-butter__arr" aria-hidden="true">&#x2192;</span>
                {%- else -%}
                  Sold Out
                {%- endif -%}
              </button>

              {%- if current_product.available -%}
                <a
                  href="/checkout?variant={{ current_variant.id }}&quantity=1"
                  class="btn-checkout"
                  id="checkout-btn"
                >
                  Buy it now
                </a>
              {%- endif -%}
            </div>

          {%- endform -%}

          <p class="product-trust">&#x1F6E1; 30-Day Guarantee &nbsp;&middot;&nbsp; &#x1F4E6; Free Shipping &nbsp;&middot;&nbsp; &#x26A1; Ships in 1&ndash;2 Days</p>

          <!-- Accordion -->
          <div class="product-accordion faq-list">

            <div class="faq-item">
              <button class="faq-item__trigger" aria-expanded="false">
                <span class="faq-item__question">Product details &amp; specs</span>
                <span class="faq-item__icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="6" y1="1" x2="6" y2="11"/><line x1="1" y1="6" x2="11" y2="6"/></svg>
                </span>
              </button>
              <div class="faq-item__answer">
                <p class="faq-item__body">
                  Diameter: 39 cm / 15.4&Prime; &nbsp;&middot;&nbsp;
                  Material: premium faux-sherpa &nbsp;&middot;&nbsp;
                  Frame: powder-coated iron &nbsp;&middot;&nbsp;
                  Weight capacity: 50 lbs / 23 kg &nbsp;&middot;&nbsp;
                  Clamp range: up to ~5 cm / 2&Prime; edge &nbsp;&middot;&nbsp;
                  Colour: cream/white &nbsp;&middot;&nbsp;
                  Cushion: hand-washable, air dry
                </p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-item__trigger" aria-expanded="false">
                <span class="faq-item__question">Shipping &amp; delivery</span>
                <span class="faq-item__icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="6" y1="1" x2="6" y2="11"/><line x1="1" y1="6" x2="11" y2="6"/></svg>
                </span>
              </button>
              <div class="faq-item__answer">
                <p class="faq-item__body">Free shipping to the US, Canada, and UK. Orders ship within 1&ndash;2 business days. Estimated delivery: 8&ndash;12 days to the US. Tracking number sent by email on shipment day.</p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-item__trigger" aria-expanded="false">
                <span class="faq-item__question">Returns &amp; our guarantee</span>
                <span class="faq-item__icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="6" y1="1" x2="6" y2="11"/><line x1="1" y1="6" x2="11" y2="6"/></svg>
                </span>
              </button>
              <div class="faq-item__answer">
                <p class="faq-item__body">30-day satisfaction guarantee. If your cat snubs it, email <a href="mailto:hello@deskpaws.com" style="color:var(--color-gold);">hello@deskpaws.com</a> for a full refund &mdash; you keep the bed.</p>
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Page",
  "tag": "div",
  "settings": [
    {
      "type": "textarea",
      "id": "short_description",
      "label": "Short description",
      "default": "Your cat is going to sit on your desk anyway. Give them a better spot — right next to you, without taking over your keyboard."
    }
  ]
}
{% endschema %}
