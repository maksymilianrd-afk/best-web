{%- comment -%}
  How It Works — "The 60-Second Setup"
  No photography: a bespoke line-art schematic that draws itself on as
  the minute-dial sweeps 0:20 → 0:40 → 1:00. The diagram assembles —
  clamp grips the desk, the nest forms with its occupant, the laptop
  joins — one step at a time. Falls back to the full static drawing.
{%- endcomment -%}

<section class="sw" id="how-it-works">

  <div class="sw__head">
    <span class="sw__eyebrow reveal">{{ section.settings.eyebrow | default: "Setup" }}</span>
    <h2 class="sw__title reveal" style="--reveal-delay:.06s">{{ section.settings.heading | default: "Three steps. Sixty seconds." }}</h2>
    <p class="sw__sub reveal" style="--reveal-delay:.12s">{{ section.settings.body | default: "No tools. No drilling. No manual at midnight." }}</p>
  </div>

  <div class="sw__stage">

    <!-- Self-drawing schematic + minute dial -->
    <div class="sw__viewer reveal">
      <svg class="sw__diagram" viewBox="0 0 440 340" role="img" aria-label="How DeskPaws clamps to a desk and gives your cat a spot">

        <!-- Step 1 — the clamp grips the desk edge -->
        <g class="sw__d is-drawn" data-step="0">
          <path pathLength="1" d="M250 150 L432 150"></path>
          <path pathLength="1" d="M250 150 L250 192"></path>
          <path pathLength="1" d="M250 192 L432 192"></path>
          <path pathLength="1" d="M240 146 L302 146"></path>
          <path pathLength="1" d="M240 146 L240 198"></path>
          <path pathLength="1" d="M240 198 L302 198"></path>
          <path pathLength="1" class="sw__d-accent" d="M272 192 L272 214"></path>
          <circle pathLength="1" class="sw__d-accent" cx="272" cy="221" r="7"></circle>
        </g>

        <!-- Step 2 — the nest forms, and someone settles in -->
        <g class="sw__d" data-step="1">
          <path class="sw__fill" d="M64 150 Q70 236 152 238 Q236 236 240 150 Q152 166 64 150 Z"></path>
          <path pathLength="1" d="M64 150 Q152 134 240 150"></path>
          <path pathLength="1" d="M64 150 Q152 166 240 150"></path>
          <path pathLength="1" d="M64 150 Q70 236 152 238 Q236 236 240 150"></path>
          <path pathLength="1" class="sw__d-accent" d="M110 150 Q152 110 196 150"></path>
          <path pathLength="1" class="sw__d-accent" d="M120 133 L125 121 L133 132"></path>
          <path pathLength="1" class="sw__d-accent" d="M136 129 L142 119 L150 130"></path>
        </g>

        <!-- Step 3 — keyboard clear, work resumes (cat dozing) -->
        <g class="sw__d" data-step="2">
          <path pathLength="1" d="M340 150 L388 150"></path>
          <path pathLength="1" d="M346 150 L352 128 L382 128 L388 150"></path>
          <path pathLength="1" class="sw__d-accent" d="M196 104 L208 104 L196 118 L208 118"></path>
          <path pathLength="1" class="sw__d-accent" d="M214 88 L222 88 L214 98 L222 98"></path>
        </g>
      </svg>

      <div class="sw__dial" aria-hidden="true">
        <svg class="sw__dial-svg" viewBox="0 0 100 100">
          <circle class="sw__dial-track" cx="50" cy="50" r="46" pathLength="100"></circle>
          <circle class="sw__dial-fill" cx="50" cy="50" r="46" pathLength="100"></circle>
        </svg>
        <span class="sw__dial-read">
          <span class="sw__dial-time">1:00</span>
          <span class="sw__dial-num"><b class="sw__dial-now">03</b>&thinsp;/&thinsp;03</span>
        </span>
      </div>
    </div>

    <!-- Step sequencer -->
    <ol class="sw__steps reveal" style="--reveal-delay:.1s">
      <li class="sw__step is-active" data-step="0">
        <button class="sw__step-btn" type="button" aria-label="Step 1">
          <span class="sw__step-num">01</span>
          <span class="sw__step-main">
            <span class="sw__step-title">{{ section.settings.step_1_title | default: "Clamp it on" }}</span>
            <span class="sw__step-body">{{ section.settings.step_1_body | default: "Slide the padded clamp onto any straight desk edge and hand-tighten the knob until it holds firm. No tools, no drilling, no marks." }}</span>
          </span>
        </button>
        <span class="sw__step-prog" aria-hidden="true"><span class="sw__step-prog-fill"></span></span>
      </li>
      <li class="sw__step" data-step="1">
        <button class="sw__step-btn" type="button" aria-label="Step 2">
          <span class="sw__step-num">02</span>
          <span class="sw__step-main">
            <span class="sw__step-title">{{ section.settings.step_2_title | default: "Let them settle in" }}</span>
            <span class="sw__step-body">{{ section.settings.step_2_body | default: "Set it where your cat already likes to perch and add a pinch of catnip. Then step back and let instinct do the rest." }}</span>
          </span>
        </button>
        <span class="sw__step-prog" aria-hidden="true"><span class="sw__step-prog-fill"></span></span>
      </li>
      <li class="sw__step" data-step="2">
        <button class="sw__step-btn" type="button" aria-label="Step 3">
          <span class="sw__step-num">03</span>
          <span class="sw__step-main">
            <span class="sw__step-title">{{ section.settings.step_3_title | default: "Get back to work" }}</span>
            <span class="sw__step-body">{{ section.settings.step_3_body | default: "Cat settled, keyboard clear — one hand free to reach over and scratch an ear between emails." }}</span>
          </span>
        </button>
        <span class="sw__step-prog" aria-hidden="true"><span class="sw__step-prog-fill"></span></span>
      </li>
    </ol>

  </div>

  <div class="sw__compat reveal">
    <div class="sw__compat-items">
      <span class="sw__compat-item">Solid wood</span>
      <span class="sw__compat-item">Wooden panel</span>
      <span class="sw__compat-item">Marble</span>
      <span class="sw__compat-item">Metal</span>
      <span class="sw__compat-item">Edges up to 2&Prime;</span>
    </div>
    <p class="sw__compat-note">
      {{ section.settings.compat_warning | default: "Not suitable for thin glass or curved edges. Not sure about your desk?" }}
      <a href="mailto:{{ section.settings.contact_email | default: 'hello@deskpaws.com' }}" class="sw__compat-link">{{ section.settings.contact_label | default: "Email us before you order." }}</a>
    </p>
  </div>

</section>

{% schema %}
{
  "name": "5 — How It Works",
  "tag": "section",
  "settings": [
    { "type": "text",     "id": "eyebrow", "label": "Label",       "default": "Setup" },
    { "type": "text",     "id": "heading", "label": "Heading",     "default": "Three steps. Sixty seconds." },
    { "type": "textarea", "id": "body",    "label": "Sub-headline" },
    { "type": "header",   "content": "Step 1" },
    { "type": "text",     "id": "step_1_title", "label": "Title", "default": "Clamp it on" },
    { "type": "textarea", "id": "step_1_body",  "label": "Body" },
    { "type": "header",   "content": "Step 2" },
    { "type": "text",     "id": "step_2_title", "label": "Title", "default": "Let them settle in" },
    { "type": "textarea", "id": "step_2_body",  "label": "Body" },
    { "type": "header",   "content": "Step 3" },
    { "type": "text",     "id": "step_3_title", "label": "Title", "default": "Get back to work" },
    { "type": "textarea", "id": "step_3_body",  "label": "Body" },
    { "type": "header",   "content": "Compatibility note" },
    { "type": "textarea", "id": "compat_warning", "label": "Warning text" },
    { "type": "text",     "id": "contact_email",  "label": "Contact email",  "default": "hello@deskpaws.com" },
    { "type": "text",     "id": "contact_label",  "label": "Contact link text", "default": "Email us before you order." }
  ],
  "presets": [{ "name": "How It Works" }]
}
{% endschema %}
