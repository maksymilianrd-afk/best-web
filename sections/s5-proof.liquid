<section class="setup-section" id="how-it-works">

  <!-- LEFT: image panel -->
  <div class="setup-left">

    <div class="setup-img-card">
      {%- if section.settings.image_1 -%}
        {{ section.settings.image_1 | image_url: width: 800 | image_tag: id: 'setup-main-img', loading: 'lazy', alt: section.settings.image_1.alt | default: 'DeskPaws clamp close-up' }}
      {%- else -%}
        <p class="setup-img-placeholder">Clamp<br>close-up<br>photo here</p>
      {%- endif -%}
    </div>

    <div class="setup-thumbs gallery-thumbs">
      {%- if section.settings.image_1 -%}
        <button class="setup-thumb product-thumb active" data-target="setup-main-img" data-src="{{ section.settings.image_1 | image_url: width: 800 }}" aria-label="View image 1">
          {{ section.settings.image_1 | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
        </button>
      {%- else -%}
        <div class="setup-thumb setup-thumb--empty active"></div>
      {%- endif -%}

      {%- if section.settings.image_2 -%}
        <button class="setup-thumb product-thumb" data-target="setup-main-img" data-src="{{ section.settings.image_2 | image_url: width: 800 }}" aria-label="View image 2">
          {{ section.settings.image_2 | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
        </button>
      {%- else -%}
        <div class="setup-thumb setup-thumb--empty"></div>
      {%- endif -%}

      {%- if section.settings.image_3 -%}
        <button class="setup-thumb product-thumb" data-target="setup-main-img" data-src="{{ section.settings.image_3 | image_url: width: 800 }}" aria-label="View image 3">
          {{ section.settings.image_3 | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
        </button>
      {%- else -%}
        <div class="setup-thumb setup-thumb--empty"></div>
      {%- endif -%}
    </div>

  </div>

  <!-- RIGHT: content -->
  <div class="setup-right">

    <p class="setup-lbl">{{ section.settings.eyebrow | default: "Setup" }}</p>
    <h2 class="setup-hdl">{{ section.settings.heading | default: "Three steps.<br>Sixty seconds." }}</h2>
    <p class="setup-subhdl">{{ section.settings.body | default: "No tools. No drilling. No reading a manual at midnight." }}</p>

    <div class="setup-steps">

      <div class="setup-step">
        <span class="setup-step__num">01</span>
        <div class="setup-step__content">
          <span class="setup-step__title">{{ section.settings.step_1_title | default: "Clamp it on" }}</span>
          <p class="setup-step__body">{{ section.settings.step_1_body | default: "Slide the padded G-clamp onto any straight desk edge. Hand-tighten the knob until it holds firm. That&rsquo;s it — no tools, no marks on your desk. Done in 60 seconds." }}</p>
        </div>
      </div>

      <div class="setup-step">
        <span class="setup-step__num">02</span>
        <div class="setup-step__content">
          <span class="setup-step__title">{{ section.settings.step_2_title | default: "Let them discover it" }}</span>
          <p class="setup-step__body">{{ section.settings.step_2_body | default: "Position it where your cat already likes to sit. Drop a pinch of catnip inside. Then step back. <em>Let instinct do the rest.</em>" }}</p>
        </div>
      </div>

      <div class="setup-step">
        <span class="setup-step__num">03</span>
        <div class="setup-step__content">
          <span class="setup-step__title">{{ section.settings.step_3_title | default: "Get back to work" }}</span>
          <p class="setup-step__body">{{ section.settings.step_3_body | default: "Cat settled. Keyboard clear. One hand free to reach over and scratch an ear whenever you want." }}</p>
        </div>
      </div>

    </div>

    <div class="setup-compat">
      <div class="setup-compat__items">
        <span class="setup-compat__item"><span class="setup-compat__check">&#10003;</span> Solid wood</span>
        <span class="setup-compat__item"><span class="setup-compat__check">&#10003;</span> Wooden panel</span>
        <span class="setup-compat__item"><span class="setup-compat__check">&#10003;</span> Marble</span>
        <span class="setup-compat__item"><span class="setup-compat__check">&#10003;</span> Metal</span>
        <span class="setup-compat__item"><span class="setup-compat__check">&#10003;</span> Up to 2&Prime; thick</span>
      </div>
      <p class="setup-compat__warning">
        {{ section.settings.compat_warning | default: "Not suitable for thin glass or desks with curved edges. Not sure?" }}
        <a href="mailto:{{ section.settings.contact_email | default: 'hello@deskpaws.com' }}" class="setup-compat__link">{{ section.settings.contact_label | default: "Email us before you order." }}</a>
      </p>
    </div>

  </div>

</section>

{% schema %}
{
  "name": "5 — How It Works",
  "tag": "section",
  "settings": [
    { "type": "header",       "content": "Images" },
    { "type": "image_picker", "id": "image_1",        "label": "Main image (thumbnail 1)" },
    { "type": "image_picker", "id": "image_2",        "label": "Thumbnail 2" },
    { "type": "image_picker", "id": "image_3",        "label": "Thumbnail 3" },
    { "type": "header",       "content": "Text" },
    { "type": "text",         "id": "eyebrow",        "label": "Label",       "default": "Setup" },
    { "type": "text",         "id": "heading",        "label": "Heading",     "default": "Three steps. Sixty seconds." },
    { "type": "textarea",     "id": "body",           "label": "Sub-headline" },
    { "type": "header",       "content": "Step 1" },
    { "type": "text",         "id": "step_1_title",   "label": "Title",       "default": "Clamp it on" },
    { "type": "textarea",     "id": "step_1_body",    "label": "Body" },
    { "type": "header",       "content": "Step 2" },
    { "type": "text",         "id": "step_2_title",   "label": "Title",       "default": "Let them discover it" },
    { "type": "textarea",     "id": "step_2_body",    "label": "Body" },
    { "type": "header",       "content": "Step 3" },
    { "type": "text",         "id": "step_3_title",   "label": "Title",       "default": "Get back to work" },
    { "type": "textarea",     "id": "step_3_body",    "label": "Body" },
    { "type": "header",       "content": "Compatibility note" },
    { "type": "textarea",     "id": "compat_warning", "label": "Warning text" },
    { "type": "text",         "id": "contact_email",  "label": "Contact email",  "default": "hello@deskpaws.com" },
    { "type": "text",         "id": "contact_label",  "label": "Contact link text", "default": "Email us before you order." }
  ],
  "presets": [{ "name": "How It Works" }]
}
{% endschema %}
