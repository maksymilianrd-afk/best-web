<section class="product-section product-section--image-left" id="reviews" aria-labelledby="s5-heading">
  <div class="product-section__inner">

    <div class="product-section__gallery">
      <div class="product-section__slides" id="s5-slides">
        <div class="product-section__slide">
          {%- if section.settings.ugc_image_1 -%}
            {{ section.settings.ugc_image_1 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.ugc_image_1.alt | default: 'Happy cat in DeskPaws' }}
          {%- else -%}
            <div class="ugc-placeholder">
              <span style="font-size:2.5rem;line-height:1;">&#x1F431;</span>
              <p>Upload a real customer photo here</p>
            </div>
          {%- endif -%}
        </div>
        <div class="product-section__slide">
          {%- if section.settings.ugc_image_2 -%}
            {{ section.settings.ugc_image_2 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.ugc_image_2.alt | default: 'Customer cat photo' }}
          {%- else -%}
            <img
              src="{{ 'cat-curled.png' | asset_url }}"
              alt="Cat settled in DeskPaws desk bed"
              width="720"
              height="740"
              loading="lazy"
            >
          {%- endif -%}
        </div>
      </div>
      <div class="product-section__controls" aria-label="Gallery navigation">
        <button class="btn-arrow btn-arrow--left" data-slides="s5-slides" data-dir="-1" aria-label="Previous image">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
        </button>
        <button class="btn-arrow" data-slides="s5-slides" data-dir="1" aria-label="Next image">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>

    <div class="product-section__body">
      <div class="product-section__group">
        <p class="text-subtitle">Real cats. Real desks. Real relief.</p>
        <h2 class="h2" id="s5-heading">Cats claim it faster than their owners expect.</h2>
      </div>

      <div class="stat-bar">
        <span class="stat-bar__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="stat-bar__rating">4.8</span>
        <span class="stat-bar__sep"></span>
        <span class="stat-bar__meta">Most cats settle in within 24 hours</span>
      </div>

      <div class="review-list">
        <div class="review-item">
          <p class="review-item__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
          <p class="review-item__quote">&ldquo;{{ section.settings.review_1_text | default: "She claimed it within an hour of me setting it up. I honestly didn't expect it to work this fast. Now I find her there before I even clock in for the day." }}&rdquo;</p>
          <p class="review-item__author">{{ section.settings.review_1_author | default: "Sarah &amp; Mochi" }}</p>
        </div>
        <div class="review-item">
          <p class="review-item__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
          <p class="review-item__quote">&ldquo;{{ section.settings.review_2_text | default: "My 18 lb Maine Coon fits perfectly and it doesn't budge. The clamp is rock solid. I was worried about my desk but there's not a single mark." }}&rdquo;</p>
          <p class="review-item__author">{{ section.settings.review_2_author | default: "Rachel &amp; Chairman Floof" }}</p>
        </div>
        <div class="review-item">
          <p class="review-item__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
          <p class="review-item__quote">&ldquo;{{ section.settings.review_3_text | default: "Bought this as a gift for my sister who works from home. She texted me a photo within 24 hours — cat completely settled in, keyboard completely free." }}&rdquo;</p>
          <p class="review-item__author">{{ section.settings.review_3_author | default: "Jamie &mdash; gift buyer" }}</p>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "5 — Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "ugc_image_1",
      "label": "UGC photo 1"
    },
    {
      "type": "image_picker",
      "id": "ugc_image_2",
      "label": "UGC photo 2"
    },
    {
      "type": "header",
      "content": "Review 1"
    },
    {
      "type": "textarea",
      "id": "review_1_text",
      "label": "Review text",
      "default": "She claimed it within an hour of me setting it up. I honestly didn't expect it to work this fast. Now I find her there before I even clock in for the day."
    },
    {
      "type": "text",
      "id": "review_1_author",
      "label": "Author",
      "default": "Sarah & Mochi"
    },
    {
      "type": "header",
      "content": "Review 2"
    },
    {
      "type": "textarea",
      "id": "review_2_text",
      "label": "Review text",
      "default": "My 18 lb Maine Coon fits perfectly and it doesn't budge. The clamp is rock solid. I was worried about my desk but there's not a single mark."
    },
    {
      "type": "text",
      "id": "review_2_author",
      "label": "Author",
      "default": "Rachel & Chairman Floof"
    },
    {
      "type": "header",
      "content": "Review 3"
    },
    {
      "type": "textarea",
      "id": "review_3_text",
      "label": "Review text",
      "default": "Bought this as a gift for my sister who works from home. She texted me a photo within 24 hours — cat completely settled in, keyboard completely free."
    },
    {
      "type": "text",
      "id": "review_3_author",
      "label": "Author",
      "default": "Jamie — gift buyer"
    }
  ],
  "presets": [
    {
      "name": "Reviews"
    }
  ]
}
{% endschema %}
