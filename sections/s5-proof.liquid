<section class="product-section product-section--image-left" id="how-it-works" aria-labelledby="s5-heading">
  <div class="product-section__inner">

    <div class="product-section__gallery">
      <div class="product-section__slides" id="s5-slides">
        <div class="product-section__slide">
          {%- if section.settings.image_1 -%}
            {{ section.settings.image_1 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_1.alt | default: 'DeskPaws clamp detail' }}
          {%- else -%}
            <img src="{{ 'clamp-detail.jpeg' | asset_url }}" alt="Close-up of the padded G-clamp gripping a desk edge" width="720" height="740" loading="lazy">
          {%- endif -%}
        </div>
        <div class="product-section__slide">
          {%- if section.settings.image_2 -%}
            {{ section.settings.image_2 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_2.alt | default: 'DeskPaws desk compatibility' }}
          {%- else -%}
            <img src="{{ 'product-floating-2.png' | asset_url }}" alt="DeskPaws product floating view" width="720" height="740" loading="lazy">
          {%- endif -%}
        </div>
      </div>
      <div class="product-section__controls" aria-label="Gallery navigation">
        <button class="btn-arrow btn-arrow--left" data-slides="s5-slides" data-dir="-1" aria-label="Previous image">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
        </button>
        <button class="btn-arrow" data-slides="s5-slides" data-dir="1" aria-label="Next image">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>

    <div class="product-section__body">
      <div class="product-section__group">
        <p class="text-subtitle">{{ section.settings.eyebrow | default: "Setup" }}</p>
        <h2 class="h2" id="s5-heading">{{ section.settings.heading | default: "Three steps. Sixty seconds." }}</h2>
        <p class="text-paragraph">
          {{ section.settings.body | default: "No tools. No drilling. No reading a manual at midnight." }}
        </p>
      </div>

      <ol class="steps-list">
        <li>
          <span class="steps-list__num">01</span>
          <div class="steps-list__text">
            <strong>{{ section.settings.step_1_title | default: "Clamp it on" }}</strong> &mdash;
            {{ section.settings.step_1_body | default: "Padded G-clamp grips any straight desk edge. Hand-tighten by twisting the knob &mdash; no tools needed. Done in 60 seconds." }}
          </div>
        </li>
        <li>
          <span class="steps-list__num">02</span>
          <div class="steps-list__text">
            <strong>{{ section.settings.step_2_title | default: "Add a pinch of catnip" }}</strong> &mdash;
            {{ section.settings.step_2_body | default: "Place it at desk height where your cat already likes to hang out. Sprinkle a little catnip. Let them investigate at their own pace." }}
          </div>
        </li>
        <li>
          <span class="steps-list__num">03</span>
          <div class="steps-list__text">
            <strong>{{ section.settings.step_3_title | default: "Get back to work" }}</strong> &mdash;
            {{ section.settings.step_3_body | default: "Cat settled. Keyboard clear. One hand free to reach over and scratch an ear whenever you want." }}
          </div>
        </li>
      </ol>

      <div class="product-section__group">
        <p class="text-small" style="color:var(--color-text-muted);">
          &#10003; Solid wood &nbsp;&middot;&nbsp; &#10003; Wooden panel &nbsp;&middot;&nbsp; &#10003; Marble &nbsp;&middot;&nbsp; &#10003; Metal &nbsp;&middot;&nbsp; &#10003; Up to 2&Prime; thick
          <br>Not suitable for thin glass or desks with unusual curved lips.
          <a href="mailto:hello@deskpaws.com" style="color:var(--color-gold);text-decoration:underline;text-underline-offset:2px;">Not sure? Email us.</a>
        </p>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "5 — How It Works",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image_1",      "label": "Gallery image 1" },
    { "type": "image_picker", "id": "image_2",      "label": "Gallery image 2" },
    { "type": "text",     "id": "eyebrow",          "label": "Eyebrow",   "default": "Setup" },
    { "type": "text",     "id": "heading",          "label": "Heading",   "default": "Three steps. Sixty seconds." },
    { "type": "textarea", "id": "body",             "label": "Intro text" },
    { "type": "header",   "content": "Step 1" },
    { "type": "text",     "id": "step_1_title",     "label": "Title",     "default": "Clamp it on" },
    { "type": "textarea", "id": "step_1_body",      "label": "Body" },
    { "type": "header",   "content": "Step 2" },
    { "type": "text",     "id": "step_2_title",     "label": "Title",     "default": "Add a pinch of catnip" },
    { "type": "textarea", "id": "step_2_body",      "label": "Body" },
    { "type": "header",   "content": "Step 3" },
    { "type": "text",     "id": "step_3_title",     "label": "Title",     "default": "Get back to work" },
    { "type": "textarea", "id": "step_3_body",      "label": "Body" }
  ],
  "presets": [{ "name": "How It Works" }]
}
{% endschema %}
