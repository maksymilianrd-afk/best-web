<div class="pdp-reviews" id="product-reviews">

  <h2 class="pdp-reviews__heading">{{ section.settings.heading | default: "Customer Reviews" }}</h2>

  <div class="pdp-reviews__list">
    {%- for block in section.blocks -%}
      {%- assign r = block.settings.rating | default: 5 | plus: 0 -%}
      <div class="pdp-review-card" {{ block.shopify_attributes }}>

        <div class="pdp-review-card__meta">
          {%- if block.settings.country != blank -%}
            <p class="pdp-review-card__country">{{ block.settings.country }}</p>
          {%- endif -%}
          <div class="pdp-review-card__stars">
            {%- for i in (1..5) -%}
              {%- if i <= r -%}<span class="star star--full">&#9733;</span>{%- else -%}<span class="star star--empty">&#9734;</span>{%- endif -%}
            {%- endfor -%}
          </div>
          <p class="pdp-review-card__name">{{ block.settings.reviewer_name | default: "Customer" }}</p>
          {%- if block.settings.date != blank -%}
            <p class="pdp-review-card__date">{{ block.settings.date }}</p>
          {%- endif -%}
        </div>

        <div class="pdp-review-card__content">
          {%- if block.settings.title != blank -%}
            <h3 class="pdp-review-card__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <p class="pdp-review-card__body">{{ block.settings.body }}</p>
          {%- endif -%}
          {%- if block.settings.photo -%}
            <div class="pdp-review-card__imgs">
              <img
                src="{{ block.settings.photo | image_url: width: 400 }}"
                alt="{{ block.settings.photo.alt | default: 'Customer photo' }}"
                class="pdp-review-card__img"
                width="160" height="160"
                loading="lazy"
              >
            </div>
          {%- endif -%}
          {%- if block.settings.variant != blank -%}
            <p class="pdp-review-card__variant">{{ block.settings.variant }}</p>
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "Product Reviews",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Customer Reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text",         "id": "country",       "label": "Country (with flag)",   "default": "🇺🇸 United States" },
        { "type": "range",        "id": "rating",        "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text",         "id": "reviewer_name", "label": "Reviewer name",         "default": "Happy Customer" },
        { "type": "text",         "id": "date",          "label": "Date",                  "default": "05/25/2026" },
        { "type": "text",         "id": "title",         "label": "Review title" },
        { "type": "textarea",     "id": "body",          "label": "Review text" },
        { "type": "image_picker", "id": "photo",         "label": "Customer photo (optional)" },
        { "type": "text",         "id": "variant",       "label": "Variant purchased" }
      ]
    }
  ],
  "presets": [{ "name": "Product Reviews" }]
}
{% endschema %}
