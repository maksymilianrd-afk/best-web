<section class="benefits-section" id="benefits">

  <div class="benefits-top-rule"></div>
  <span class="benefits-section-label">{{ section.settings.eyebrow | default: "Why it works" }}</span>

  <div class="benefits-grid">

    <div class="benefit-col">
      <span class="benefit-num">01</span>
      <h3 class="benefit-title">{{ section.settings.card_1_title | default: "Closeness without chaos" }}</h3>
      <p class="benefit-body">{{ section.settings.card_1_body | default: "Your cat stays right beside you at desk height — exactly where they want to be — without a single paw on your keyboard. That's the compromise you've both been waiting for." }}</p>
    </div>

    <div class="benefit-col">
      <span class="benefit-num">02</span>
      <h3 class="benefit-title">{{ section.settings.card_2_title | default: "Your keyboard is yours again" }}</h3>
      <p class="benefit-body">{{ section.settings.card_2_body | default: "No more &ldquo;asdfjkl;&rdquo; in the middle of a Slack message. Your cat has their spot — and you have yours. Finally." }}</p>
    </div>

    <div class="benefit-col">
      <span class="benefit-num">03</span>
      <h3 class="benefit-title">{{ section.settings.card_3_title | default: "They'll actually use it" }}</h3>
      <p class="benefit-body">{{ section.settings.card_3_body | default: "The deep nest shape isn't accidental. Cats instinctively seek enclosed, bowl-shaped spaces. Most claim it within the first day — no convincing required." }}</p>
    </div>

    <div class="benefit-col">
      <span class="benefit-num">04</span>
      <h3 class="benefit-title">{{ section.settings.card_4_title | default: "On in 60 seconds, no tools" }}</h3>
      <p class="benefit-body">{{ section.settings.card_4_body | default: "The padded clamp slides onto your desk edge and tightens by hand. No tools, no drilling, no marks on your desk. Move it whenever you want." }}</p>
    </div>

    <div class="benefit-col">
      <span class="benefit-num">05</span>
      <h3 class="benefit-title">{{ section.settings.card_5_title | default: "Fits any desk surface" }}</h3>
      <p class="benefit-body">{{ section.settings.card_5_body | default: "Solid wood, marble, metal — if it has a straight edge up to 2&Prime; thick, DeskPaws clamps to it. Rubber pads protect every surface." }}</p>
    </div>

    <div class="benefit-col">
      <span class="benefit-num">06</span>
      <h3 class="benefit-title">{{ section.settings.card_6_title | default: "Holds the chonkiest cat" }}</h3>
      <p class="benefit-body">{{ section.settings.card_6_body | default: "Powder-coated steel frame rated to 50 lbs. Maine Coons, Ragdolls, your suspiciously heavy rescue included. Zero wobble on impact landing." }}</p>
    </div>

  </div>

  <div class="benefits-bottom">
    <p class="benefits-bottom-copy">{{ section.settings.cta_copy | default: "&ldquo;Now I have to remind myself to pet her — because she&rsquo;s not on my keyboard.&rdquo;" }}</p>
    <a href="{{ section.settings.cta_url | default: '/products/desk-paws-place-for-your-cat-co-worker' }}" class="btn-benefits-cta">
      {{ section.settings.cta_label | default: "Give Them Their Spot &rarr;" }}
    </a>
  </div>

</section>

{% schema %}
{
  "name": "3 — Features & Benefits",
  "tag": "section",
  "settings": [
    { "type": "text",     "id": "eyebrow",      "label": "Section label", "default": "Why it works" },
    { "type": "header",   "content": "Card 1" },
    { "type": "text",     "id": "card_1_title", "label": "Title", "default": "Closeness without chaos" },
    { "type": "textarea", "id": "card_1_body",  "label": "Body" },
    { "type": "header",   "content": "Card 2" },
    { "type": "text",     "id": "card_2_title", "label": "Title", "default": "Your keyboard is yours again" },
    { "type": "textarea", "id": "card_2_body",  "label": "Body" },
    { "type": "header",   "content": "Card 3" },
    { "type": "text",     "id": "card_3_title", "label": "Title", "default": "They'll actually use it" },
    { "type": "textarea", "id": "card_3_body",  "label": "Body" },
    { "type": "header",   "content": "Card 4" },
    { "type": "text",     "id": "card_4_title", "label": "Title", "default": "On in 60 seconds, no tools" },
    { "type": "textarea", "id": "card_4_body",  "label": "Body" },
    { "type": "header",   "content": "Card 5" },
    { "type": "text",     "id": "card_5_title", "label": "Title", "default": "Fits any desk surface" },
    { "type": "textarea", "id": "card_5_body",  "label": "Body" },
    { "type": "header",   "content": "Card 6" },
    { "type": "text",     "id": "card_6_title", "label": "Title", "default": "Holds the chonkiest cat" },
    { "type": "textarea", "id": "card_6_body",  "label": "Body" },
