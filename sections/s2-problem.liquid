<section class="meet" id="meet-deskpaws">

  <div class="meet-left">
    <div class="meet-stage">

      <div class="meet-frame reveal">
        <div class="meet-frame__back" aria-hidden="true"></div>

        <div class="meet-slides" id="meet-slides">
          <div class="meet-slide meet-slide--active">
            {%- if section.settings.image_1 -%}
              {{ section.settings.image_1 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_1.alt | default: 'DeskPaws desk cat bed' }}
            {%- else -%}
              <img src="{{ 'product-floating.png' | asset_url }}" alt="DeskPaws deep sherpa nest clamped to a desk" width="720" height="740" loading="lazy">
            {%- endif -%}
          </div>
          <div class="meet-slide">
            {%- if section.settings.image_2 -%}
              {{ section.settings.image_2 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_2.alt | default: 'DeskPaws on desk' }}
            {%- else -%}
              <img src="{{ 'product-on-desk.png' | asset_url }}" alt="DeskPaws clamped to a real desk with a cat inside" width="720" height="740" loading="lazy">
            {%- endif -%}
          </div>
          {%- if section.settings.image_3 -%}
            <div class="meet-slide">
              {{ section.settings.image_3 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_3.alt | default: 'DeskPaws detail' }}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="meet-stage__foot reveal" style="--reveal-delay:.1s">
        {%- if section.settings.image_caption != blank -%}
          <span class="meet-stage__cap">{{ section.settings.image_caption }}</span>
        {%- endif -%}
        <div class="meet-dots" id="meet-dots" aria-label="Gallery navigation">
          <button class="meet-dot meet-dot--active" data-slide="0" aria-label="View image 1"></button>
          <button class="meet-dot" data-slide="1" aria-label="View image 2"></button>
          {%- if section.settings.image_3 -%}
            <button class="meet-dot" data-slide="2" aria-label="View image 3"></button>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>

  <div class="meet-right">

    {%- if section.settings.eyebrow != blank -%}
      <span class="meet-label reveal"><span class="meet-label__line" aria-hidden="true"></span>{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h2 class="meet-headline reveal" style="--reveal-delay:.06s">{{ section.settings.heading | default: "A nest that belongs on your desk." }}</h2>

    <p class="meet-body reveal" style="--reveal-delay:.12s">{{ section.settings.body | default: "A deep, sherpa-lined nest that clamps flush to your desk edge — walled on three sides, so your cat feels held. Close enough to reach without looking up. Far enough to keep your keyboard yours." }}</p>

    <div class="meet-rule reveal" style="--reveal-delay:.16s"></div>

    <blockquote class="meet-quote reveal" style="--reveal-delay:.2s">
      <p>{{ section.settings.pullquote | default: "I genuinely didn't think it would work. She was in it within two hours. Now I have to remind myself to pet her — she's not on my keyboard anymore." }}</p>
      <cite>{{ section.settings.pullquote_author | default: "Amanda K. & Biscuit" }}</cite>
    </blockquote>

    <div class="meet-specs">
      <div class="meet-spec reveal" style="--reveal-delay:.26s">
        <span class="spec-val">{{ section.settings.spec_1_val | default: "50 lbs" }}</span>
        <span class="spec-label">{{ section.settings.spec_1_label | default: "Max load" }}</span>
      </div>
      <div class="meet-spec reveal" style="--reveal-delay:.32s">
        <span class="spec-val">{{ section.settings.spec_2_val | default: "39 cm" }}</span>
        <span class="spec-label">{{ section.settings.spec_2_label | default: "Nest diameter" }}</span>
      </div>
      <div class="meet-spec reveal" style="--reveal-delay:.38s">
        <span class="spec-val">{{ section.settings.spec_3_val | default: "60 sec" }}</span>
        <span class="spec-label">{{ section.settings.spec_3_label | default: "To install" }}</span>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "2 — Meet DeskPaws",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image_1",          "label": "Gallery image 1" },
    { "type": "image_picker", "id": "image_2",          "label": "Gallery image 2" },
    { "type": "image_picker", "id": "image_3",          "label": "Gallery image 3 (optional)" },
    { "type": "text",         "id": "image_caption",    "label": "Image caption",    "default": "Sherpa nest · clamp-on" },
    { "type": "text",         "id": "eyebrow",          "label": "Eyebrow",          "default": "Meet DeskPaws" },
    { "type": "text",         "id": "heading",          "label": "Heading",          "default": "A nest that belongs on your desk." },
    { "type": "textarea",     "id": "body",             "label": "Body paragraph" },
    { "type": "textarea",     "id": "pullquote",        "label": "Pull quote" },
    { "type": "text",         "id": "pullquote_author", "label": "Quote attribution", "default": "Amanda K. & Biscuit" },
    { "type": "header",       "content": "Specs" },
    { "type": "text", "id": "spec_1_val",   "label": "Spec 1 value",  "default": "50 lbs" },
    { "type": "text", "id": "spec_1_label", "label": "Spec 1 label",  "default": "Max load" },
    { "type": "text", "id": "spec_2_val",   "label": "Spec 2 value",  "default": "39 cm" },
    { "type": "text", "id": "spec_2_label", "label": "Spec 2 label",  "default": "Nest diameter" },
    { "type": "text", "id": "spec_3_val",   "label": "Spec 3 value",  "default": "60 sec" },
    { "type": "text", "id": "spec_3_label", "label": "Spec 3 label",  "default": "To install" }
  ],
  "presets": [{ "name": "Meet DeskPaws" }]
}
{% endschema %}
