<section class="product-section product-section--image-left" id="meet-deskpaws" aria-labelledby="s2-heading">
  <div class="product-section__inner">

    <div class="product-section__gallery">
      <div class="product-section__slides" id="s2-slides">
        <div class="product-section__slide">
          {%- if section.settings.image_1 -%}
            {{ section.settings.image_1 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_1.alt | default: 'DeskPaws desk cat bed' }}
          {%- else -%}
            <img src="{{ 'product-floating.png' | asset_url }}" alt="DeskPaws deep sherpa nest clamped to a desk" width="720" height="740" loading="lazy">
          {%- endif -%}
        </div>
        <div class="product-section__slide">
          {%- if section.settings.image_2 -%}
            {{ section.settings.image_2 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_2.alt | default: 'DeskPaws on desk' }}
          {%- else -%}
            <img src="{{ 'product-on-desk.png' | asset_url }}" alt="DeskPaws clamped to a real desk with a cat inside" width="720" height="740" loading="lazy">
          {%- endif -%}
        </div>
      </div>
      <div class="product-section__controls" aria-label="Gallery navigation">
        <button class="btn-arrow btn-arrow--left" data-slides="s2-slides" data-dir="-1" aria-label="Previous image">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
        </button>
        <button class="btn-arrow" data-slides="s2-slides" data-dir="1" aria-label="Next image">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>

    <div class="product-section__body">
      <div class="product-section__group">
        <p class="text-subtitle">{{ section.settings.eyebrow | default: "Meet DeskPaws" }}</p>
        <h2 class="h2" id="s2-heading">{{ section.settings.heading | default: "A nest that belongs on your desk." }}</h2>
        <p class="text-paragraph">
          {{ section.settings.body | default: "DeskPaws is a deep, sherpa-lined bowl that clamps flush to your desk edge. Your cat gets an enclosed, cozy perch right at your elbow &mdash; close enough to touch without touching your keyboard." }}
        </p>
      </div>

      <div class="product-section__group">
        <p class="text-paragraph">
          {{ section.settings.body_2 | default: "Most desk beds are flat mesh hammocks. Cats instinctively avoid open, exposed surfaces &mdash; they seek enclosed, nest-like hideaways. The deep bowl shape works with that instinct, not against it. That&rsquo;s why cats actually stay in it." }}
        </p>
      </div>

      <blockquote class="pull-quote">
        {{ section.settings.pullquote | default: "I genuinely didn&rsquo;t think it would work. She was in it within two hours. Now I have to remind myself to pet her because she&rsquo;s not on my keyboard." }}
        <cite>{{ section.settings.pullquote_author | default: "Amanda K. &amp; Biscuit &mdash; verified buyer" }}</cite>
      </blockquote>

      <div class="product-section__cta">
        <a href="{{ section.settings.cta_url | default: routes.root_url | append: 'products/deskpaws' }}" class="btn btn--secondary">
          {{ section.settings.cta_label | default: "See It Up Close" }}
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
        </a>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "2 — Meet DeskPaws",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Gallery image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Gallery image 2" },
    { "type": "text",     "id": "eyebrow",          "label": "Eyebrow",    "default": "Meet DeskPaws" },
    { "type": "text",     "id": "heading",           "label": "Heading",    "default": "A nest that belongs on your desk." },
    { "type": "textarea", "id": "body",              "label": "Body paragraph 1" },
    { "type": "textarea", "id": "body_2",            "label": "Body paragraph 2" },
    { "type": "textarea", "id": "pullquote",         "label": "Pull quote" },
    { "type": "text",     "id": "pullquote_author",  "label": "Quote attribution", "default": "Amanda K. & Biscuit — verified buyer" },
    { "type": "text",     "id": "cta_label",         "label": "CTA text",   "default": "See It Up Close" },
    { "type": "url",      "id": "cta_url",           "label": "CTA link" }
  ],
  "presets": [{ "name": "Meet DeskPaws" }]
}
{% endschema %}
