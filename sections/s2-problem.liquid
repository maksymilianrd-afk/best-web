<section class="product-section product-section--image-right" id="the-bed" aria-labelledby="s2-heading">
  <div class="product-section__inner">

    <div class="product-section__body">
      <div class="product-section__group">
        <p class="text-subtitle">The daily chaos</p>
        <h2 class="h2" id="s2-heading">You know&nbsp;the&nbsp;routine.</h2>
        <p class="text-paragraph">
          You sit down, open the laptop, and within two minutes there they are &mdash; strolling across the keyboard, parking between you and the monitor, &ldquo;helping&rdquo; you send <code style="background:rgba(44,26,17,0.07);padding:1px 5px;font-size:0.85em;">TGFFFF8F4$$</code> to the group chat.
        </p>
      </div>

      <ul class="fails-list">
        <li><span class="fail-icon">&mdash;</span> <s>Floor bed &mdash; they ignore it</s></li>
        <li><span class="fail-icon">&mdash;</span> <s>Closed door &mdash; the guilt is unbearable</s></li>
        <li><span class="fail-icon">&mdash;</span> <s>Lap &mdash; try typing like that</s></li>
      </ul>

      <div class="product-section__group">
        <p class="text-paragraph">
          Moving them off the desk doesn&rsquo;t feel like winning. It feels like turning your friend away. They just want to be near you &mdash; which is why nothing you&rsquo;ve tried has worked.
        </p>
        <p class="text-paragraph">
          So we stopped trying to keep cats off the desk. We built them a better place to be.
        </p>
      </div>

      <blockquote class="pull-quote">
        <em>Meowcro management</em> &mdash; happening 6&ndash;10&times; before noon.
        <cite>Every WFH cat parent, ever</cite>
      </blockquote>
    </div>

    <div class="product-section__gallery">
      <div class="product-section__slides" id="s2-slides">
        <div class="product-section__slide">
          {%- if section.settings.image_1 -%}
            {{ section.settings.image_1 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_1.alt | default: 'Cat in DeskPaws bed' }}
          {%- else -%}
            <img
              src="{{ 'cat-curled.png' | asset_url }}"
              alt="Fluffy cat curled up in DeskPaws desk bed"
              width="720"
              height="740"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div class="product-section__slide">
          {%- if section.settings.image_2 -%}
            {{ section.settings.image_2 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_2.alt | default: 'DeskPaws on desk' }}
          {%- else -%}
            <img
              src="{{ 'product-on-desk.png' | asset_url }}"
              alt="DeskPaws bed clamped on a dark wooden desk"
              width="720"
              height="740"
              loading="lazy"
            >
          {%- endif -%}
        </div>
      </div>
      <div class="product-section__controls" aria-label="Gallery navigation">
        <button class="btn-arrow btn-arrow--left" data-slides="s2-slides" data-dir="-1" aria-label="Previous image">
          <svg width="20" height="12" viewBox="0 0 20 12" fill="none" aria-hidden="true"><path d="M19 6H1M6 1L1 6l5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="btn-arrow" data-slides="s2-slides" data-dir="1" aria-label="Next image">
          <svg width="20" height="12" viewBox="0 0 20 12" fill="none" aria-hidden="true"><path d="M1 6h18M14 1l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "2 — The Problem",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Gallery image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Gallery image 2"
    }
  ],
  "presets": [
    {
      "name": "The Problem"
    }
  ]
}
{% endschema %}
