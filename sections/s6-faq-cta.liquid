<section class="before-after" id="before-after" aria-label="Before and after DeskPaws">

  <div class="before-after__panel before-after__panel--before">
    <p class="before-after__label">Before</p>
    <h2 class="before-after__heading">
      {{ section.settings.before_heading | default: "The desk you know a little too well." }}
    </h2>
    <ul class="before-after__items">
      <li class="before-after__item">
        <span class="before-after__item-icon">&#x26A0;&#xFE0F;</span>
        <span>{{ section.settings.before_1 | default: "Cat planted on your keyboard mid-email. Again." }}</span>
      </li>
      <li class="before-after__item">
        <span class="before-after__item-icon">&#x1F910;</span>
        <span>{{ section.settings.before_2 | default: "Muted yourself on the call. Too late &mdash; everyone heard the meowing." }}</span>
      </li>
      <li class="before-after__item">
        <span class="before-after__item-icon">&#x1F614;</span>
        <span>{{ section.settings.before_3 | default: "You pushed them off. They gave you that look. You felt terrible for the next hour." }}</span>
      </li>
      <li class="before-after__item">
        <span class="before-after__item-icon">&#x1F4BB;</span>
        <span>{{ section.settings.before_4 | default: "Locked them out. They scratched at the door for 20 minutes. Guilt won." }}</span>
      </li>
    </ul>
    <p style="font-size:0.875rem;color:rgba(255,255,255,0.4);font-style:italic;">
      {{ section.settings.before_caption | default: "This is not a productivity problem. It&rsquo;s a furniture problem." }}
    </p>
  </div>

  <div class="before-after__panel before-after__panel--after">
    <p class="before-after__label">After DeskPaws</p>
    <h2 class="before-after__heading">
      {{ section.settings.after_heading | default: "The workday you&rsquo;ve been trying to build." }}
    </h2>
    <ul class="before-after__items">
      <li class="before-after__item">
        <span class="before-after__item-icon">&#x2714;&#xFE0F;</span>
        <span>{{ section.settings.after_1 | default: "Cat curled up six inches from your elbow, purring." }}</span>
      </li>
      <li class="before-after__item">
        <span class="before-after__item-icon">&#x2714;&#xFE0F;</span>
        <span>{{ section.settings.after_2 | default: "Call went the full hour. Clean audio. Professional." }}</span>
      </li>
      <li class="before-after__item">
        <span class="before-after__item-icon">&#x2714;&#xFE0F;</span>
        <span>{{ section.settings.after_3 | default: "You reached over and scratched an ear between emails. Everyone happy." }}</span>
      </li>
      <li class="before-after__item">
        <span class="before-after__item-icon">&#x2714;&#xFE0F;</span>
        <span>{{ section.settings.after_4 | default: "Keyboard yours. Desk yours. Cat content. You&rsquo;re a good parent and a functional human, simultaneously." }}</span>
      </li>
    </ul>
    <div class="before-after__cta">
      <a href="{{ section.settings.cta_url | default: '/products/desk-paws-place-for-your-cat-co-worker' }}" class="btn btn--secondary">
        {{ section.settings.cta_label | default: "Get That Workday &mdash; $79" }}
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
      </a>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "6 — Before / After",
  "tag": "section",
  "settings": [
    { "type": "text",     "id": "before_heading", "label": "Before heading",  "default": "The desk you know a little too well." },
    { "type": "text",     "id": "before_1",       "label": "Before item 1" },
    { "type": "text",     "id": "before_2",       "label": "Before item 2" },
    { "type": "text",     "id": "before_3",       "label": "Before item 3" },
    { "type": "text",     "id": "before_4",       "label": "Before item 4" },
    { "type": "text",     "id": "before_caption", "label": "Before caption" },
    { "type": "text",     "id": "after_heading",  "label": "After heading",   "default": "The workday you've been trying to build." },
    { "type": "text",     "id": "after_1",        "label": "After item 1" },
    { "type": "text",     "id": "after_2",        "label": "After item 2" },
    { "type": "text",     "id": "after_3",        "label": "After item 3" },
    { "type": "text",     "id": "after_4",        "label": "After item 4" },
    { "type": "text",     "id": "cta_label",      "label": "CTA text",        "default": "Get That Workday — $79" },
    { "type": "url",      "id": "cta_url",        "label": "CTA link" }
  ],
  "presets": [{ "name": "Before / After" }]
}
{% endschema %}
