<header class="header header--overlay" id="site-header" role="banner">
  <div class="header__inner">

    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }} — home">
      <span class="header__logo-text">Desk</span><span class="header__logo-paws">Paws</span>
    </a>

    <a href="{{ routes.cart_url }}" class="header__cart" aria-label="Cart">
      Cart
      {%- if cart.item_count > 0 -%}
        <span class="header__cart-count">{{ cart.item_count }}</span>
      {%- endif -%}
    </a>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
