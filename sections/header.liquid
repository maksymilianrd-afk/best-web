<header class="header{% if template.name == 'index' %} header--overlay{% else %} is-scrolled{% endif %}" id="site-header" role="banner">
  <div class="header__inner">

    <nav class="header__nav-left" aria-label="Left navigation">
      <a href="{{ routes.root_url }}pages/about" class="header__nav-link">About</a>
      <a href="{{ routes.root_url }}pages/faq" class="header__nav-link">FAQ</a>
      <a href="{{ routes.root_url }}pages/shipping-policy" class="header__nav-link">Shipping</a>
    </nav>

    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }} &mdash; home">
      <span class="header__logo-text">Desk</span><span class="header__logo-paws">Paws</span>
    </a>

    <div class="header__nav-right">
      <a href="{{ routes.root_url }}pages/contact" class="header__nav-link">Contact</a>
      <a href="{%- if template.name == 'index' -%}#buy{%- else -%}/products/deskpaws{%- endif -%}" class="btn btn--secondary">
        Buy Now
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true">
          <path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="header__cart" aria-label="Cart">
        Cart
        {%- if cart.item_count > 0 -%}
          <span class="header__cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
