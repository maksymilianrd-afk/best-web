<section class="rv-section" id="reviews">

  <div class="rv-header">
    <p class="rv-eyebrow">{{ section.settings.eyebrow | default: "Real cats. Real desks." }}</p>
    <h2 class="rv-hdl">{{ section.settings.heading | default: "What happens when the keyboard is finally yours again." }}</h2>
    <div class="rv-score" aria-label="Five-star rated">
      <div class="rv-score__stars" aria-hidden="true">
        {%- for i in (1..5) -%}<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{%- endfor -%}
      </div>
      <span class="rv-score__meta">{{ section.settings.stat_meta | default: "From our customers" }}</span>
    </div>
  </div>

  <div class="rv-grid">

    <article class="review-card rv-card">
      <div class="rv-card__stars" aria-label="5 out of 5 stars">
        {%- for i in (1..5) -%}<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{%- endfor -%}
      </div>
      <blockquote class="rv-card__quote">
        <p>{{ section.settings.review_1 | default: "She was in it within an hour of setup. I genuinely didn&rsquo;t expect it to work that fast. Now I find her already settled in every morning before I even sit down." }}</p>
      </blockquote>
      <footer class="rv-card__foot">
        <p class="rv-card__author">{{ section.settings.review_1_author | default: "Sarah M. &amp; Biscuit" }}</p>
        <p class="rv-card__tag">
          {%- if section.settings.review_1_tag != blank -%}{{ section.settings.review_1_tag }}{%- else -%}Claimed in 1 hour{%- endif -%}
        </p>
      </footer>
    </article>

    <article class="review-card rv-card">
      <div class="rv-card__stars" aria-label="5 out of 5 stars">
        {%- for i in (1..5) -%}<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{%- endfor -%}
      </div>
      <blockquote class="rv-card__quote">
        <p>{{ section.settings.review_2 | default: "My 18 lb Maine Coon fits perfectly. The clamp is rock solid &mdash; zero wobble even when he jumps in. Not a single mark on my desk." }}</p>
      </blockquote>
      <footer class="rv-card__foot">
        <p class="rv-card__author">{{ section.settings.review_2_author | default: "Rachel T. &amp; Chairman Floof" }}</p>
        <p class="rv-card__tag">
          {%- if section.settings.review_2_tag != blank -%}{{ section.settings.review_2_tag }}{%- else -%}Large cat owner{%- endif -%}
        </p>
      </footer>
    </article>

    <article class="review-card rv-card">
      <div class="rv-card__stars" aria-label="5 out of 5 stars">
        {%- for i in (1..5) -%}<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{%- endfor -%}
      </div>
      <blockquote class="rv-card__quote">
        <p>{{ section.settings.review_3 | default: "I bought this as a gift. My sister texted me a photo within 24 hours &mdash; cat completely settled, keyboard completely clear. It actually works." }}</p>
      </blockquote>
      <footer class="rv-card__foot">
        <p class="rv-card__author">{{ section.settings.review_3_author | default: "Jamie L." }}</p>
        <p class="rv-card__tag">
          {%- if section.settings.review_3_tag != blank -%}{{ section.settings.review_3_tag }}{%- else -%}Gift buyer{%- endif -%}
        </p>
      </footer>
    </article>

    <article class="review-card rv-card">
      <div class="rv-card__stars" aria-label="5 out of 5 stars">
        {%- for i in (1..5) -%}<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{%- endfor -%}
      </div>
      <blockquote class="rv-card__quote">
        <p>{{ section.settings.review_4 | default: "I was on six calls this week and didn&rsquo;t have to apologise for my cat once. That alone was worth $79 to me." }}</p>
      </blockquote>
      <footer class="rv-card__foot">
        <p class="rv-card__author">{{ section.settings.review_4_author | default: "Priya K. &amp; Mango" }}</p>
        <p class="rv-card__tag">
          {%- if section.settings.review_4_tag != blank -%}{{ section.settings.review_4_tag }}{%- else -%}Work from home{%- endif -%}
        </p>
      </footer>
    </article>

    <article class="review-card rv-card">
      <div class="rv-card__stars" aria-label="5 out of 5 stars">
        {%- for i in (1..5) -%}<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{%- endfor -%}
      </div>
      <blockquote class="rv-card__quote">
        <p>{{ section.settings.review_5 | default: "Set it up Sunday night. Monday morning she was in it before my coffee was ready. I actually teared up a little. Ridiculous but true." }}</p>
      </blockquote>
      <footer class="rv-card__foot">
        <p class="rv-card__author">{{ section.settings.review_5_author | default: "Leah R. &amp; Duchess" }}</p>
        <p class="rv-card__tag">
          {%- if section.settings.review_5_tag != blank -%}{{ section.settings.review_5_tag }}{%- else -%}Claimed overnight{%- endif -%}
        </p>
      </footer>
    </article>

    <article class="review-card rv-card">
      <div class="rv-card__stars" aria-label="5 out of 5 stars">
        {%- for i in (1..5) -%}<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{%- endfor -%}
      </div>
      <blockquote class="rv-card__quote">
        <p>{{ section.settings.review_6 | default: "The sherpa cushion is so soft even I want to sleep in it. Removes easily for washing. Genuinely great product." }}</p>
      </blockquote>
      <footer class="rv-card__foot">
        <p class="rv-card__author">{{ section.settings.review_6_author | default: "Dana W. &amp; Gnocchi" }}</p>
        <p class="rv-card__tag">
          {%- if section.settings.review_6_tag != blank -%}{{ section.settings.review_6_tag }}{%- else -%}Washable liner{%- endif -%}
        </p>
      </footer>
    </article>

  </div>

  <div class="reviews-cta rv-cta">
    <p class="rv-cta__closing">{{ section.settings.cta_closing | default: "You&rsquo;re a good cat parent and a functional human. Simultaneously." }}</p>
    <h3 class="rv-cta__hdl">{{ section.settings.cta_heading | default: "Your desk. Their spot. Everyone wins." }}</h3>
    <p class="rv-cta__price">$79</p>
    <a href="{{ section.settings.cta_url | default: '/products/desk-paws-place-for-your-cat-co-worker' }}" class="reviews-cta__btn rv-cta__btn" data-buy-drawer>
      {{ section.settings.cta_label | default: "Give Them Their Spot" }}
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="10" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
    </a>
    <p class="rv-cta__trust">Free shipping &middot; 30-day guarantee &middot; Secure checkout</p>
  </div>

</section>

{% schema %}
{
  "name": "7 — Reviews",
  "tag": "section",
  "settings": [
    { "type": "text",     "id": "eyebrow",           "label": "Eyebrow",          "default": "Real cats. Real desks." },
    { "type": "text",     "id": "heading",           "label": "Heading",          "default": "What happens when the keyboard is finally yours again." },
    { "type": "text",     "id": "stat_meta",         "label": "Rating label",     "default": "From our customers" },
    { "type": "header",   "content": "Review 1" },
    { "type": "textarea", "id": "review_1",          "label": "Quote" },
    { "type": "text",     "id": "review_1_author",   "label": "Author",           "default": "Sarah M. & Biscuit" },
    { "type": "text",     "id": "review_1_tag",      "label": "Tag",              "default": "Claimed in 1 hour" },
    { "type": "header",   "content": "Review 2" },
    { "type": "textarea", "id": "review_2",          "label": "Quote" },
    { "type": "text",     "id": "review_2_author",   "label": "Author",           "default": "Rachel T. & Chairman Floof" },
    { "type": "text",     "id": "review_2_tag",      "label": "Tag",              "default": "Large cat owner" },
    { "type": "header",   "content": "Review 3" },
    { "type": "textarea", "id": "review_3",          "label": "Quote" },
    { "type": "text",     "id": "review_3_author",   "label": "Author",           "default": "Jamie L." },
    { "type": "text",     "id": "review_3_tag",      "label": "Tag",              "default": "Gift buyer" },
    { "type": "header",   "content": "Review 4" },
    { "type": "textarea", "id": "review_4",          "label": "Quote" },
    { "type": "text",     "id": "review_4_author",   "label": "Author",           "default": "Priya K. & Mango" },
    { "type": "text",     "id": "review_4_tag",      "label": "Tag",              "default": "Work from home" },
    { "type": "header",   "content": "Review 5" },
    { "type": "textarea", "id": "review_5",          "label": "Quote" },
    { "type": "text",     "id": "review_5_author",   "label": "Author",           "default": "Leah R. & Duchess" },
    { "type": "text",     "id": "review_5_tag",      "label": "Tag",              "default": "Claimed overnight" },
    { "type": "header",   "content": "Review 6" },
    { "type": "textarea", "id": "review_6",          "label": "Quote" },
    { "type": "text",     "id": "review_6_author",   "label": "Author",           "default": "Dana W. & Gnocchi" },
    { "type": "text",     "id": "review_6_tag",      "label": "Tag",              "default": "Washable liner" },
    { "type": "header",   "content": "CTA section" },
    { "type": "textarea", "id": "cta_closing",       "label": "Closing italic line" },
    { "type": "text",     "id": "cta_heading",       "label": "CTA heading",      "default": "Your desk. Their spot. Everyone wins." },
    { "type": "text",     "id": "cta_label",         "label": "Button text",      "default": "Give Them Their Spot" },
    { "type": "url",      "id": "cta_url",           "label": "Button link" }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
