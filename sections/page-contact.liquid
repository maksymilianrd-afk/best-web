<div class="pgs-wrap pgs-contact">

  <div class="pgs-hero">
    <p class="pgs-eyebrow">Support</p>
    <h1 class="pgs-heading">Get in touch</h1>
    <p class="pgs-subhead">We read every message personally and reply within one business day.</p>
  </div>

  <div class="pgs-content">
    <div class="con-layout">

      <div class="con-info">
        <div class="con-info__block">
          <p class="con-info__label">Email</p>
          <a href="mailto:hello@deskpaws.com" class="con-info__value pgs-link">hello@deskpaws.com</a>
        </div>
        <div class="con-info__block">
          <p class="con-info__label">Hours</p>
          <p class="con-info__value">Monday &ndash; Friday<br>9am &ndash; 5pm EST</p>
        </div>
        <div class="con-info__block">
          <p class="con-info__label">Response time</p>
          <p class="con-info__value">We aim to reply within one business day. For order questions, please include your order number.</p>
        </div>
        <div class="con-info__block">
          <p class="con-info__label">Quick answers</p>
          <ul class="con-info__list">
            <li><a href="{{ routes.root_url }}pages/faq" class="pgs-link">Frequently asked questions</a></li>
            <li><a href="{{ routes.root_url }}pages/shipping-policy" class="pgs-link">Shipping information</a></li>
          </ul>
        </div>
      </div>

      <div class="con-form-wrap">
        {% form 'contact' %}
          {%- if form.posted_successfully? -%}
            <div class="con-success">
              <p class="con-success__heading">Message sent.</p>
              <p class="con-success__body">Thank you &mdash; we&rsquo;ll be in touch within one business day.</p>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div class="con-form-error" role="alert">
                <p>Please review the following:</p>
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="con-field">
              <label class="con-field__label" for="con-name">Name</label>
              <input class="con-field__input" type="text" id="con-name" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
            </div>

            <div class="con-field">
              <label class="con-field__label" for="con-email">Email</label>
              <input class="con-field__input" type="email" id="con-email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
            </div>

            <div class="con-field">
              <label class="con-field__label" for="con-message">Message</label>
              <textarea class="con-field__input con-field__textarea" id="con-message" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
            </div>

            <button type="submit" class="btn btn--secondary con-submit">
              Send message
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="10" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
            </button>
          {%- endif -%}
        {% endform %}
      </div>

    </div>
  </div>

</div>

{% schema %}{ "name": "Contact Page", "settings": [] }{% endschema %}
