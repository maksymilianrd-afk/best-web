<div class="pdp-reviews-header">

  <h2 class="pdp-reviews__heading">{{ section.settings.heading | default: "Customer Reviews" }}</h2>

  <div class="pdp-reviews__summary">

    <div class="pdp-reviews__score-block">
      <div class="pdp-reviews__score-row">
        <span class="pdp-reviews__score">{{ section.settings.average_rating | default: "4.8" }}</span>
        <div class="pdp-reviews__stars">
          {%- assign avg_round = section.settings.average_rating | default: "4.8" | times: 1 | round -%}
          {%- for i in (1..5) -%}
            {%- if i <= avg_round -%}<span class="star star--full">&#9733;</span>{%- else -%}<span class="star star--empty">&#9734;</span>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <p class="pdp-reviews__total">Based on {{ section.settings.total_reviews | default: 59 }} Reviews</p>
    </div>

    <div class="pdp-reviews__breakdown">
      {%- assign total = section.settings.total_reviews | default: 1 | plus: 0 -%}
      {%- if total == 0 -%}{%- assign total = 1 -%}{%- endif -%}

      {%- assign c5 = section.settings.stars_5 | default: 0 | plus: 0 -%}
      {%- assign p5 = c5 | times: 100 | divided_by: total -%}
      <div class="pdp-reviews__bar-row">
        <span class="pdp-reviews__bar-label">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <div class="pdp-reviews__bar-track"><div class="pdp-reviews__bar-fill" style="width:{{ p5 }}%"></div></div>
        <span class="pdp-reviews__bar-count">({{ c5 }})</span>
      </div>

      {%- assign c4 = section.settings.stars_4 | default: 0 | plus: 0 -%}
      {%- assign p4 = c4 | times: 100 | divided_by: total -%}
      <div class="pdp-reviews__bar-row">
        <span class="pdp-reviews__bar-label">&#9733;&#9733;&#9733;&#9733;&#9734;</span>
        <div class="pdp-reviews__bar-track"><div class="pdp-reviews__bar-fill" style="width:{{ p4 }}%"></div></div>
        <span class="pdp-reviews__bar-count">({{ c4 }})</span>
      </div>

      {%- assign c3 = section.settings.stars_3 | default: 0 | plus: 0 -%}
      {%- assign p3 = c3 | times: 100 | divided_by: total -%}
      <div class="pdp-reviews__bar-row">
        <span class="pdp-reviews__bar-label">&#9733;&#9733;&#9733;&#9734;&#9734;</span>
        <div class="pdp-reviews__bar-track"><div class="pdp-reviews__bar-fill" style="width:{{ p3 }}%"></div></div>
        <span class="pdp-reviews__bar-count">({{ c3 }})</span>
      </div>

      {%- assign c2 = section.settings.stars_2 | default: 0 | plus: 0 -%}
      {%- assign p2 = c2 | times: 100 | divided_by: total -%}
      <div class="pdp-reviews__bar-row">
        <span class="pdp-reviews__bar-label">&#9733;&#9733;&#9734;&#9734;&#9734;</span>
        <div class="pdp-reviews__bar-track"><div class="pdp-reviews__bar-fill" style="width:{{ p2 }}%"></div></div>
        <span class="pdp-reviews__bar-count">({{ c2 }})</span>
      </div>

      {%- assign c1 = section.settings.stars_1 | default: 0 | plus: 0 -%}
      {%- assign p1 = c1 | times: 100 | divided_by: total -%}
      <div class="pdp-reviews__bar-row">
        <span class="pdp-reviews__bar-label">&#9733;&#9734;&#9734;&#9734;&#9734;</span>
        <div class="pdp-reviews__bar-track"><div class="pdp-reviews__bar-fill" style="width:{{ p1 }}%"></div></div>
        <span class="pdp-reviews__bar-count">({{ c1 }})</span>
      </div>
    </div>

  </div>

  {%- if section.settings.photo_1 or section.settings.photo_2 or section.settings.photo_3 or section.settings.photo_4 or section.settings.photo_5 or section.settings.photo_6 -%}
  <div class="pdp-reviews__photos">
    {%- if section.settings.photo_1 -%}<img src="{{ section.settings.photo_1 | image_url: width: 300 }}" alt="{{ section.settings.photo_1.alt | default: 'Customer photo' }}" class="pdp-reviews__photo" width="90" height="90" loading="lazy">{%- endif -%}
    {%- if section.settings.photo_2 -%}<img src="{{ section.settings.photo_2 | image_url: width: 300 }}" alt="{{ section.settings.photo_2.alt | default: 'Customer photo' }}" class="pdp-reviews__photo" width="90" height="90" loading="lazy">{%- endif -%}
    {%- if section.settings.photo_3 -%}<img src="{{ section.settings.photo_3 | image_url: width: 300 }}" alt="{{ section.settings.photo_3.alt | default: 'Customer photo' }}" class="pdp-reviews__photo" width="90" height="90" loading="lazy">{%- endif -%}
    {%- if section.settings.photo_4 -%}<img src="{{ section.settings.photo_4 | image_url: width: 300 }}" alt="{{ section.settings.photo_4.alt | default: 'Customer photo' }}" class="pdp-reviews__photo" width="90" height="90" loading="lazy">{%- endif -%}
    {%- if section.settings.photo_5 -%}<img src="{{ section.settings.photo_5 | image_url: width: 300 }}" alt="{{ section.settings.photo_5.alt | default: 'Customer photo' }}" class="pdp-reviews__photo" width="90" height="90" loading="lazy">{%- endif -%}
    {%- if section.settings.photo_6 -%}<img src="{{ section.settings.photo_6 | image_url: width: 300 }}" alt="{{ section.settings.photo_6.alt | default: 'Customer photo' }}" class="pdp-reviews__photo" width="90" height="90" loading="lazy">{%- endif -%}
  </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Reviews — Summary",
  "tag": "div",
  "settings": [
    { "type": "text",    "id": "heading",        "label": "Heading",          "default": "Customer Reviews" },
    { "type": "text",    "id": "average_rating", "label": "Average rating",   "default": "4.8" },
    { "type": "number",  "id": "total_reviews",  "label": "Total reviews",    "default": 59 },
    { "type": "header",  "content": "Rating breakdown" },
    { "type": "number",  "id": "stars_5",        "label": "5-star count",     "default": 50 },
    { "type": "number",  "id": "stars_4",        "label": "4-star count",     "default": 7 },
    { "type": "number",  "id": "stars_3",        "label": "3-star count",     "default": 1 },
    { "type": "number",  "id": "stars_2",        "label": "2-star count",     "default": 0 },
    { "type": "number",  "id": "stars_1",        "label": "1-star count",     "default": 1 },
    { "type": "header",  "content": "Customer photos (up to 6)" },
    { "type": "image_picker", "id": "photo_1",   "label": "Photo 1" },
    { "type": "image_picker", "id": "photo_2",   "label": "Photo 2" },
    { "type": "image_picker", "id": "photo_3",   "label": "Photo 3" },
    { "type": "image_picker", "id": "photo_4",   "label": "Photo 4" },
    { "type": "image_picker", "id": "photo_5",   "label": "Photo 5" },
    { "type": "image_picker", "id": "photo_6",   "label": "Photo 6" }
  ],
  "presets": [{ "name": "Reviews — Summary" }]
}
{% endschema %}
