<footer class="footer" role="contentinfo">
  <div class="footer__top">
    <div class="footer__columns">

      <div class="footer__col">
        <span class="footer__col-label">Shop</span>
        <ul class="footer__links">
          <li><a href="{{ routes.root_url }}products/deskpaws-cat-bed">DeskPaws Bed</a></li>
          <li><a href="{{ routes.cart_url }}">Cart</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <span class="footer__col-label">Help</span>
        <ul class="footer__links">
          <li><a href="{{ routes.root_url }}pages/faq">FAQ</a></li>
          <li><a href="{{ routes.root_url }}pages/shipping-policy">Shipping</a></li>
          <li><a href="{{ routes.root_url }}pages/return-policy">Returns</a></li>
          <li><a href="{{ routes.root_url }}pages/pdr">Product Guide</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <span class="footer__col-label">Contact</span>
        <p class="footer__contact-line">
          <a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a><br>
          Mon–Fri, 9am–5pm EST
        </p>
      </div>

    </div>
  </div>

  <div class="footer__bottom">
    <a href="{{ routes.root_url }}" class="footer__logo">
      Desk<span class="footer__logo-paws">Paws</span>
    </a>
    <p class="footer__copy">&copy; {{ 'now' | date: '%Y' }} DeskPaws</p>
    <div class="footer__payments">
      <span class="footer__payment-badge">Visa</span>
      <span class="footer__payment-badge">MC</span>
      <span class="footer__payment-badge">PayPal</span>
      <span class="footer__payment-badge">Amex</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
