<div class="ft-outer" id="site-footer-outer">
  <div class="ft-pin">
    <footer class="footer" role="contentinfo">

      <div class="ft-blob ft-blob--1" aria-hidden="true"></div>
      <div class="ft-blob ft-blob--2" aria-hidden="true"></div>

      <div class="ft-inner">

        <nav class="ft-nav" aria-label="Footer navigation">

          <div class="ft-nav__col" style="--col-i: 0">
            <span class="ft-nav__label">Shop</span>
            <ul class="ft-nav__list">
              <li><a href="/products/desk-paws-place-for-your-cat-co-worker">DeskPaws Bed</a></li>
              <li><a href="{{ routes.cart_url }}">Cart</a></li>
            </ul>
          </div>

          <div class="ft-nav__col" style="--col-i: 1">
            <span class="ft-nav__label">Help</span>
            <ul class="ft-nav__list">
              <li><a href="{{ routes.root_url }}pages/faq">FAQ</a></li>
              <li><a href="{{ routes.root_url }}pages/shipping-policy">Shipping</a></li>
              <li><a href="{{ routes.root_url }}pages/return-policy">Returns</a></li>
              <li><a href="{{ routes.root_url }}pages/pdr">Product Guide</a></li>
            </ul>
          </div>

          <div class="ft-nav__col" style="--col-i: 2">
            <span class="ft-nav__label">Contact</span>
            <ul class="ft-nav__list">
              <li><a href="{{ routes.root_url }}">Home</a></li>
              <li><a href="{{ routes.root_url }}pages/contact">Contact Us</a></li>
              {%- if settings.support_email != blank -%}
                <li><a href="mailto:{{ settings.support_email }}" class="ft-nav__email">{{ settings.support_email }}</a></li>
              {%- endif -%}
            </ul>
          </div>

        </nav>

        <div class="ft-bottom">

          <div class="ft-bottom__left">
            <a href="{{ routes.root_url }}" class="ft-wordmark" aria-label="{{ shop.name }} &mdash; home">
              Desk<em>Paws</em>
            </a>
            <div class="ft-tagline">
              <span class="ft-tagline__line" aria-hidden="true"></span>
              <span class="ft-tagline__text">For the cat who already owns your desk.</span>
            </div>
          </div>

          <div class="ft-bottom__right">
            <p class="ft-copy">&copy; {{ 'now' | date: '%Y' }} DeskPaws</p>
            <div class="ft-payments" aria-label="Accepted payment methods">
              <span class="ft-payment">Visa</span>
              <span class="ft-payment">MC</span>
              <span class="ft-payment">PayPal</span>
              <span class="ft-payment">Amex</span>
            </div>
          </div>

        </div>

      </div>

    </footer>
  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
