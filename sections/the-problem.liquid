{%- comment -%}
  The Problem — editorial typographic poem.
  Reference: repeated-word rows, one trail breaking away on a curve,
  story copy set in the negative space. Typography-led; no imagery.
{%- endcomment -%}

{%- assign word       = section.settings.repeat_word  | default: 'Miew.' -%}
{%- assign bare       = word | remove: '.' -%}
{%- assign bare_size  = bare | size -%}
{%- assign bare_max   = bare_size | minus: 1 -%}

{%- assign eyebrow    = section.settings.eyebrow      | default: 'Sound familiar?' -%}
{%- assign line_open  = section.settings.line_open    | default: 'You sit down to work.' -%}
{%- assign line_why_1 = section.settings.line_why_1   | default: "Not because they're naughty." -%}
{%- assign line_why_2 = section.settings.line_why_2   | default: 'Because they want you.' -%}
{%- assign line_wh_1  = section.settings.line_where_1 | default: 'On the keyboard.' -%}
{%- assign line_wh_2  = section.settings.line_where_2 | default: 'Between you and the screen.' -%}
{%- assign line_wh_3  = section.settings.line_where_3 | default: 'Right where your attention was supposed to be.' -%}
{%- assign line_move  = section.settings.line_move    | default: 'You move them. They come back.' -%}
{%- assign micro_again = section.settings.micro_again | default: 'again.' -%}
{%- assign line_love  = section.settings.line_love    | default: 'You love them completely.' -%}
{%- assign line_end   = section.settings.line_end     | default: "You still haven't finished a sentence since 9am." -%}
{%- assign line_close = section.settings.line_close   | default: 'So we gave them a better place to be.' -%}
{%- assign micro_1    = section.settings.micro_1      | default: 'look at me' -%}
{%- assign micro_2    = section.settings.micro_2      | default: 'not now' -%}

<section class="tp" id="theProblem">

  {%- comment -%} Repeated word rows — soft / strong / soft / strong-with-breakaway {%- endcomment -%}
  <div class="tp__rows" aria-hidden="true">

    <div class="tp__row tp__row--soft tp__row--first reveal">
      <div class="tp__drift">
        <span class="tp__rt">{% for i in (1..14) %}{{ word }}&nbsp;{% endfor %}</span>
        <span class="tp__rt">{% for i in (1..14) %}{{ word }}&nbsp;{% endfor %}</span>
      </div>
    </div>

    <div class="tp__row tp__row--strong tp__row--second reveal" style="--reveal-delay:.08s">
      <span class="tp__rt">{% for i in (1..18) %}{{ word }} {% endfor %}</span>
    </div>

    <div class="tp__row tp__row--soft tp__row--third reveal" style="--reveal-delay:.16s">
      <span class="tp__rt">{% for i in (1..18) %}{{ word }} {% endfor %}</span>
    </div>

    <div class="tp__row tp__row--strong tp__row--break reveal" style="--reveal-delay:.24s">
      <span class="tp__rt">{{ word }} {{ word }} <span class="tp__w3">{{ word }} </span></span>
      <span class="tp__spread">{% for i in (0..bare_max) %}<span>{{ bare | slice: i, 1 }}</span>{% endfor %}</span>
      <span class="tp__arc">
        <span class="tp__fw tp__fw--1 reveal" style="--reveal-delay:.40s">{{ bare }}</span>
        <span class="tp__fw tp__fw--2 reveal" style="--reveal-delay:.52s">{{ bare }}</span>
        <span class="tp__fw tp__fw--3 reveal" style="--reveal-delay:.64s">{{ bare }}</span>
        <span class="tp__fw tp__fw--4 reveal" style="--reveal-delay:.76s">{{ bare }}</span>
        <span class="tp__fw tp__fw--5 reveal" style="--reveal-delay:.88s">{{ bare }}</span>
        <span class="tp__fw tp__fw--6 reveal" style="--reveal-delay:1s">{{ bare }}</span>
        <span class="tp__fl tp__fl--1 reveal" style="--reveal-delay:1.1s">{{ bare | slice: 0, 1 }}</span>
        <span class="tp__fl tp__fl--2 reveal" style="--reveal-delay:1.18s">{{ bare | slice: 1, 1 }}</span>
        <span class="tp__fl tp__fl--3 reveal" style="--reveal-delay:1.26s">{{ bare | slice: 2, 1 }}</span>
        <span class="tp__fl tp__fl--4 reveal" style="--reveal-delay:1.34s">{{ bare | slice: 3, 1 }}</span>
      </span>
    </div>

  </div>

  <div class="tp__body">

    <span class="tp__note tp__note--1 reveal" aria-hidden="true">{{ micro_1 }}</span>
    <span class="tp__note tp__note--2 reveal" aria-hidden="true">{{ micro_2 }}</span>

    <div class="tp__story">

      <p class="tp__eyebrow reveal">{{ eyebrow }}</p>

      <p class="tp__line tp__line--open reveal">{{ line_open }}</p>

      <p class="tp__call tp__call--1 reveal">{{ word }}</p>
      <p class="tp__call tp__call--2 reveal" style="--reveal-delay:.14s">{{ word }} {{ word }}</p>
      <p class="tp__call tp__call--3 reveal" style="--reveal-delay:.28s">{{ word }} {{ word }} {{ word }}</p>

      <p class="tp__line reveal">{{ line_why_1 }}</p>
      <p class="tp__want reveal" style="--reveal-delay:.12s">{{ line_why_2 }}</p>

      {%- assign wh1_words = line_wh_1 | split: ' ' -%}
      <p class="tp__line tp__line--w1 reveal">
        {%- for w in wh1_words -%}
          {%- if forloop.last -%}
            {%- assign w_size = w | size -%}
            {%- assign w_max = w_size | minus: 1 -%}
            <span class="tp__scatter">{% for i in (0..w_max) %}<span>{{ w | slice: i, 1 }}</span>{% endfor %}</span>
          {%- else -%}
            {{ w }}
          {% endif -%}
        {%- endfor -%}
      </p>
      <p class="tp__line tp__line--w2 reveal" style="--reveal-delay:.1s">{{ line_wh_2 }}</p>
      <p class="tp__line tp__line--w3 reveal" style="--reveal-delay:.2s">{{ line_wh_3 }}</p>

      <p class="tp__line tp__line--move reveal">{{ line_move }}</p>
      <p class="tp__again reveal" style="--reveal-delay:.3s">{{ micro_again }}</p>

      <p class="tp__love reveal">{{ line_love }}</p>

      <p class="tp__line tp__line--end reveal" style="--reveal-delay:.25s">{{ line_end | replace: '9am', '<em>9am</em>' }}</p>

      <p class="tp__close reveal">{{ line_close }}</p>

    </div>

  </div>

</section>

{% schema %}
{
  "name": "The Problem",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "repeat_word",  "label": "Repeated word",            "default": "Miew." },
    { "type": "text", "id": "eyebrow",      "label": "Eyebrow",                  "default": "Sound familiar?" },
    { "type": "header", "content": "Story" },
    { "type": "text", "id": "line_open",    "label": "Opening line",             "default": "You sit down to work." },
    { "type": "text", "id": "line_why_1",   "label": "Why — line 1",             "default": "Not because they're naughty." },
    { "type": "text", "id": "line_why_2",   "label": "Why — line 2 (emphasis)",  "default": "Because they want you." },
    { "type": "text", "id": "line_where_1", "label": "Where — line 1 (last word scatters)", "default": "On the keyboard." },
    { "type": "text", "id": "line_where_2", "label": "Where — line 2",           "default": "Between you and the screen." },
    { "type": "text", "id": "line_where_3", "label": "Where — line 3",           "default": "Right where your attention was supposed to be." },
    { "type": "text", "id": "line_move",    "label": "Move line",                "default": "You move them. They come back." },
    { "type": "text", "id": "line_love",    "label": "Emotional line",           "default": "You love them completely." },
    { "type": "text", "id": "line_end",     "label": "Punchline (9am gets emphasis)", "default": "You still haven't finished a sentence since 9am." },
    { "type": "text", "id": "line_close",   "label": "Closing line",             "default": "So we gave them a better place to be." },
    { "type": "header", "content": "Small interruptions" },
    { "type": "text", "id": "micro_again",  "label": "After the move line",      "default": "again." },
    { "type": "text", "id": "micro_1",      "label": "Margin note 1",            "default": "look at me" },
    { "type": "text", "id": "micro_2",      "label": "Margin note 2",            "default": "not now" }
  ],
  "presets": [{ "name": "The Problem" }]
}
{% endschema %}
