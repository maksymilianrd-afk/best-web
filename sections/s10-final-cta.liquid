<section class="final-cta" id="get-it" aria-labelledby="s10-heading">

  <p class="final-cta__eyebrow">{{ section.settings.eyebrow | default: "Still scrolling?" }}</p>

  <h2 class="final-cta__heading" id="s10-heading">
    {{ section.settings.heading | default: "Work peacefully. Without pushing your cat away." }}
  </h2>

  <p class="final-cta__sub">
    {{ section.settings.subhead | default: "Your cat wants to be near you. You want to get things done. DeskPaws is the $79 solution that makes both true at the same time." }}
  </p>

  <a href="{{ section.settings.cta_url | default: routes.root_url | append: 'products/deskpaws' }}" class="btn--white">
    {{ section.settings.cta_label | default: "Claim My Cat&rsquo;s Spot &mdash; $79" }}
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
  </a>

  <p style="font-size:0.8125rem;color:rgba(255,255,255,0.35);">
    &#x1F512; Secure checkout &middot; Free shipping &middot; 30-day guarantee &middot; Ships in 1&ndash;2 days
  </p>

</section>

{% schema %}
{
  "name": "10 — Final CTA",
  "tag": "section",
  "settings": [
    { "type": "text",     "id": "eyebrow",   "label": "Eyebrow",    "default": "Still scrolling?" },
    { "type": "text",     "id": "heading",   "label": "Heading",    "default": "Work peacefully. Without pushing your cat away." },
    { "type": "textarea", "id": "subhead",   "label": "Subheading" },
    { "type": "text",     "id": "cta_label", "label": "CTA text",   "default": "Claim My Cat's Spot — $79" },
    { "type": "url",      "id": "cta_url",   "label": "CTA link" }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
