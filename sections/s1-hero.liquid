<section class="hero" id="hero">

  <div class="hero__background">
    {%- if section.settings.hero_image -%}
      {{ section.settings.hero_image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_image.alt | default: 'Cat relaxing in DeskPaws desk bed' }}
    {%- else -%}
      <img
        src="{{ 'hero-desk.png' | asset_url }}"
        alt="Cat relaxing in DeskPaws bed clamped to a wooden desk"
        width="2000"
        height="1200"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="hero__overlay"></div>

  <div class="hero__container">
    <h1 class="h1 hero__title">
      {%- if section.settings.headline != blank -%}
        {{ section.settings.headline }}
      {%- else -%}
        Finally &mdash; a truce with your <em>feline coworker.</em>
      {%- endif -%}
    </h1>

    <p class="hero__description">
      {{ section.settings.subheadline | default: "The clamp-on desk bed that gives your cat their own space — right next to yours. No drilling. No drama. Just a very happy cat." }}
    </p>

    <div class="hero__buttons">
      <a href="{{ section.settings.cta_url | default: routes.root_url | append: 'products/deskpaws' }}" class="btn btn--primary-fill">
        {{ section.settings.cta_label | default: "Claim My Cat's Spot — $79" }}
      </a>
      <a href="#the-bed" class="btn btn--text btn--white">
        See how it works
        <svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
          <path d="M0 5h13.5M10 1l4.5 4-4.5 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "1 — Hero",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline (use <em> for italics)",
      "default": "Finally — a truce with your feline coworker."
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "The clamp-on desk bed that gives your cat their own space — right next to yours. No drilling. No drama. Just a very happy cat."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button text",
      "default": "Claim My Cat's Spot — $79"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
