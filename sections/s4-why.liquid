<section class="product-section product-section--image-right" id="why-it-works" aria-labelledby="s4-heading">
  <div class="product-section__inner">

    <div class="product-section__body">
      <div class="product-section__group">
        <p class="text-subtitle">Built for how cats actually behave</p>
        <h2 class="h2" id="s4-heading">Most desk beds are flat. Cats hate flat.</h2>
        <p class="text-paragraph">
          Flat hammocks leave your cat exposed &mdash; so half the time they ignore it and climb right back onto your keyboard. DeskPaws is a deep, wrap-around nest. Cats are wired to seek cozy, enclosed spaces, so they sink in and stay. The shape isn&rsquo;t a style choice &mdash; it&rsquo;s <em>why your cat will actually use it.</em>
        </p>
      </div>

      <div class="specs-table">
        <div class="spec-row">
          <span class="spec-row__key">Weight limit</span>
          <span class="spec-row__divider">&mdash;</span>
          <span class="spec-row__value">Up to 50 lbs (22 kg)</span>
        </div>
        <div class="spec-row">
          <span class="spec-row__key">Clamp range</span>
          <span class="spec-row__divider">&mdash;</span>
          <span class="spec-row__value">Up to 2&Prime; (5 cm) thick</span>
        </div>
        <div class="spec-row">
          <span class="spec-row__key">Bed size</span>
          <span class="spec-row__divider">&mdash;</span>
          <span class="spec-row__value">12&Prime; &times; 12&Prime; (30 &times; 30 cm)</span>
        </div>
        <div class="spec-row">
          <span class="spec-row__key">Frame</span>
          <span class="spec-row__divider">&mdash;</span>
          <span class="spec-row__value">Powder-coated steel</span>
        </div>
        <div class="spec-row">
          <span class="spec-row__key">Cushion</span>
          <span class="spec-row__divider">&mdash;</span>
          <span class="spec-row__value">Removable sherpa cover</span>
        </div>
        <div class="spec-row">
          <span class="spec-row__key">Desk pads</span>
          <span class="spec-row__divider">&mdash;</span>
          <span class="spec-row__value">Soft rubber, no scratches</span>
        </div>
        <div class="spec-row">
          <span class="spec-row__key">Cleaning</span>
          <span class="spec-row__divider">&mdash;</span>
          <span class="spec-row__value">Hand-wash cover, air dry</span>
        </div>
        <div class="spec-row">
          <span class="spec-row__key">Setup</span>
          <span class="spec-row__divider">&mdash;</span>
          <span class="spec-row__value">60 seconds, no tools</span>
        </div>
      </div>

      <p class="text-paragraph-small">
        Works on solid wood, wooden panel, marble, and metal desks with a straight edge up to ~2&Prime; thick. Not ideal for thin glass or unusually curved desk lips.
        <a href="mailto:hello@deskpaws.com" style="color:var(--color-gold);text-decoration:underline;text-underline-offset:2px;">Not sure? Email us.</a>
      </p>
    </div>

    <div class="product-section__gallery">
      <div class="product-section__slides" id="s4-slides">
        <div class="product-section__slide">
          {%- if section.settings.image_1 -%}
            {{ section.settings.image_1 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_1.alt | default: 'DeskPaws deep nest' }}
          {%- else -%}
            <img
              src="{{ 'product-floating.png' | asset_url }}"
              alt="DeskPaws bed — side view showing deep nest shape"
              width="720"
              height="740"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div class="product-section__slide">
          {%- if section.settings.image_2 -%}
            {{ section.settings.image_2 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_2.alt | default: 'DeskPaws texture' }}
          {%- else -%}
            <img
              src="{{ 'texture-detail.png' | asset_url }}"
              alt="Close-up of DeskPaws sherpa texture"
              width="720"
              height="740"
              loading="lazy"
            >
          {%- endif -%}
        </div>
      </div>
      <div class="product-section__controls" aria-label="Gallery navigation">
        <button class="btn-arrow btn-arrow--left" data-slides="s4-slides" data-dir="-1" aria-label="Previous image">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
        </button>
        <button class="btn-arrow" data-slides="s4-slides" data-dir="1" aria-label="Next image">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "4 — Why It Works",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Gallery image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Gallery image 2"
    }
  ],
  "presets": [
    {
      "name": "Why It Works"
    }
  ]
}
{% endschema %}
