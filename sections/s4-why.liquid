<section class="cat-wall" id="will-my-cat-use-it">

  <!-- LEFT: photo mosaic -->
  <div class="cat-wall__left">

    <div class="cat-wall__mosaic-header">
      <span class="cwm-title">{{ section.settings.photo_wall_title | default: "Cats who claimed their spot" }}</span>
      <span class="cwm-count">{{ section.settings.photo_wall_count | default: "247 &amp; counting" }}</span>
    </div>

    <div class="cat-wall__mosaic">

      <div class="cwt cwt--a">
        {%- if section.settings.photo_1 -%}
          {{ section.settings.photo_1 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'cwt__img', alt: section.settings.cat_1_name | default: 'Customer cat photo' }}
          <span class="cwt__badge">Customer photo</span>
        {%- endif -%}
        <div class="cwt__overlay">
          <span class="cwt__name">{{ section.settings.cat_1_name | default: "Luna" }}</span>
          <span class="cwt__handle">{{ section.settings.cat_1_handle | default: "@sarahm · claimed in 1 day" }}</span>
        </div>
      </div>

      <div class="cwt cwt--b">
        {%- if section.settings.photo_2 -%}
          {{ section.settings.photo_2 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'cwt__img', alt: section.settings.cat_2_name | default: 'Customer cat photo' }}
        {%- endif -%}
        <div class="cwt__overlay">
          <span class="cwt__name">{{ section.settings.cat_2_name | default: "Biscuit" }}</span>
          <span class="cwt__handle">{{ section.settings.cat_2_handle | default: "@amandak · 2 hours" }}</span>
        </div>
      </div>

      <div class="cwt cwt--c">
        {%- if section.settings.photo_3 -%}
          {{ section.settings.photo_3 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'cwt__img', alt: section.settings.cat_3_name | default: 'Customer cat photo' }}
          <span class="cwt__badge">Customer photo</span>
        {%- endif -%}
        <div class="cwt__overlay">
          <span class="cwt__name">{{ section.settings.cat_3_name | default: "Mochi" }}</span>
          <span class="cwt__handle">{{ section.settings.cat_3_handle | default: "@jen_wfh · 1 day" }}</span>
        </div>
      </div>

      <div class="cwt cwt--d">
        {%- if section.settings.photo_4 -%}
          {{ section.settings.photo_4 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'cwt__img', alt: section.settings.cat_4_name | default: 'Customer cat photo' }}
        {%- endif -%}
        <div class="cwt__overlay">
          <span class="cwt__name">{{ section.settings.cat_4_name | default: "Gus" }}</span>
          <span class="cwt__handle">{{ section.settings.cat_4_handle | default: "@rach · 20 min" }}</span>
        </div>
      </div>

      <div class="cwt cwt--e">
        {%- if section.settings.photo_5 -%}
          {{ section.settings.photo_5 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'cwt__img', alt: section.settings.cat_5_name | default: 'Customer cat photo' }}
        {%- endif -%}
        <div class="cwt__overlay">
          <span class="cwt__name">{{ section.settings.cat_5_name | default: "Oliver" }}</span>
          <span class="cwt__handle">{{ section.settings.cat_5_handle | default: "@maya · 1 day" }}</span>
        </div>
      </div>

      <div class="cwt cwt--f">
        {%- if section.settings.photo_6 -%}
          {{ section.settings.photo_6 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'cwt__img', alt: section.settings.cat_6_name | default: 'Customer cat photo' }}
        {%- endif -%}
        <div class="cwt__overlay">
          <span class="cwt__name">{{ section.settings.cat_6_name | default: "Noodle" }}</span>
          <span class="cwt__handle">{{ section.settings.cat_6_handle | default: "@kates · 45 min" }}</span>
        </div>
      </div>

      <div class="cwt cwt--g">
        {%- if section.settings.photo_7 -%}
          {{ section.settings.photo_7 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'cwt__img', alt: section.settings.cat_7_name | default: 'Customer cat photo' }}
        {%- endif -%}
        <div class="cwt__overlay">
          <span class="cwt__name">{{ section.settings.cat_7_name | default: "Pepper" }}</span>
          <span class="cwt__handle">{{ section.settings.cat_7_handle | default: "@lisac · 1 day" }}</span>
        </div>
      </div>

    </div>

    <div class="cat-wall__mosaic-footer">
      <span class="cwm-dot"></span>
      <span class="cwm-footer-text">All photos from verified buyers</span>
    </div>

  </div>

  <!-- RIGHT: content -->
  <div class="cat-wall__right">

    <p class="cwr-lbl">{{ section.settings.eyebrow | default: "The question everyone asks" }}</p>

    <h2 class="cwr-hdl">
      {%- if section.settings.heading != blank -%}
        {{ section.settings.heading }}
      {%- else -%}
        Will my cat<br><em>actually</em> use it?
      {%- endif -%}
    </h2>

    <p class="cwr-body">{{ section.settings.body | default: "Most do — usually within the first day. Here's why the shape matters more than you'd think." }}</p>

    <div class="cwr-rule"></div>

    <div class="cwr-reasons">

      <div class="cwr-reason">
        <span class="cwr-reason__num">01</span>
        <div>
          <span class="cwr-reason__title">{{ section.settings.reason_1_title | default: "Cats seek enclosed spaces by instinct" }}</span>
          <p class="cwr-reason__body">{{ section.settings.reason_1_body | default: "The deep bowl mimics nest-like hideaways cats naturally seek. The walls wrap around them — triggering that &ldquo;I&rsquo;m staying here&rdquo; response." }}</p>
        </div>
      </div>

      <div class="cwr-reason">
        <span class="cwr-reason__num">02</span>
        <div>
          <span class="cwr-reason__title">{{ section.settings.reason_2_title | default: "Desk height is the whole point" }}</span>
          <p class="cwr-reason__body">{{ section.settings.reason_2_body | default: "They don&rsquo;t want a bed across the room. They want to be near you. This puts them exactly where they already want to be." }}</p>
        </div>
      </div>

      <div class="cwr-reason">
        <span class="cwr-reason__num">03</span>
        <div>
          <span class="cwr-reason__title">{{ section.settings.reason_3_title | default: "Still hesitant? One pinch of catnip" }}</span>
          <p class="cwr-reason__body">{{ section.settings.reason_3_body | default: "For the stubborn ones — a small amount in the nest the first time is usually all it takes." }}</p>
        </div>
      </div>

    </div>

    <div class="cwr-guarantee">
      <span class="cwr-guarantee__icon">&#x21BA;</span>
      <p class="cwr-guarantee__text">
        <strong>{{ section.settings.guarantee_heading | default: "30-day guarantee." }}</strong>
        {{ section.settings.guarantee_body | default: "If your cat wants nothing to do with it, we&rsquo;ll refund you in full. No questions asked." }}
      </p>
    </div>

  </div>

</section>

{% schema %}
{
  "name": "4 — Will My Cat Use It?",
  "tag": "section",
  "settings": [
    { "type": "header",       "content": "Photo wall" },
    { "type": "text",         "id": "photo_wall_title", "label": "Wall title",     "default": "Cats who claimed their spot" },
    { "type": "text",         "id": "photo_wall_count", "label": "Count label",    "default": "247 & counting" },
    { "type": "header",       "content": "Photo 1 (tall left tile)" },
    { "type": "image_picker", "id": "photo_1",          "label": "Cat photo 1" },
    { "type": "text",         "id": "cat_1_name",       "label": "Cat name",       "default": "Luna" },
    { "type": "text",         "id": "cat_1_handle",     "label": "Handle / time",  "default": "@sarahm · claimed in 1 day" },
    { "type": "header",       "content": "Photo 2 (top centre)" },
    { "type": "image_picker", "id": "photo_2",          "label": "Cat photo 2" },
    { "type": "text",         "id": "cat_2_name",       "label": "Cat name",       "default": "Biscuit" },
    { "type": "text",         "id": "cat_2_handle",     "label": "Handle / time",  "default": "@amandak · 2 hours" },
    { "type": "header",       "content": "Photo 3 (tall right tile)" },
    { "type": "image_picker", "id": "photo_3",          "label": "Cat photo 3" },
    { "type": "text",         "id": "cat_3_name",       "label": "Cat name",       "default": "Mochi" },
    { "type": "text",         "id": "cat_3_handle",     "label": "Handle / time",  "default": "@jen_wfh · 1 day" },
    { "type": "header",       "content": "Photo 4 (centre)" },
    { "type": "image_picker", "id": "photo_4",          "label": "Cat photo 4" },
    { "type": "text",         "id": "cat_4_name",       "label": "Cat name",       "default": "Gus" },
    { "type": "text",         "id": "cat_4_handle",     "label": "Handle / time",  "default": "@rach · 20 min" },
    { "type": "header",       "content": "Photo 5 (bottom left)" },
    { "type": "image_picker", "id": "photo_5",          "label": "Cat photo 5" },
    { "type": "text",         "id": "cat_5_name",       "label": "Cat name",       "default": "Oliver" },
    { "type": "text",         "id": "cat_5_handle",     "label": "Handle / time",  "default": "@maya · 1 day" },
    { "type": "header",       "content": "Photo 6 (bottom centre)" },
    { "type": "image_picker", "id": "photo_6",          "label": "Cat photo 6" },
    { "type": "text",         "id": "cat_6_name",       "label": "Cat name",       "default": "Noodle" },
    { "type": "text",         "id": "cat_6_handle",     "label": "Handle / time",  "default": "@kates · 45 min" },
    { "type": "header",       "content": "Photo 7 (bottom right)" },
    { "type": "image_picker", "id": "photo_7",          "label": "Cat photo 7" },
    { "type": "text",         "id": "cat_7_name",       "label": "Cat name",       "default": "Pepper" },
    { "type": "text",         "id": "cat_7_handle",     "label": "Handle / time",  "default": "@lisac · 1 day" },
    { "type": "header",       "content": "Right column" },
    { "type": "text",         "id": "eyebrow",          "label": "Eyebrow",        "default": "The question everyone asks" },
    { "type": "textarea",     "id": "heading",          "label": "Heading (HTML ok — use <em> for italic)", "default": "Will my cat\n<em>actually</em> use it?" },
    { "type": "textarea",     "id": "body",             "label": "Body paragraph" },
    { "type": "header",       "content": "Reasons (01–03)" },
    { "type": "text",         "id": "reason_1_title",   "label": "Reason 1 title", "default": "Cats seek enclosed spaces by instinct" },
    { "type": "textarea",     "id": "reason_1_body",    "label": "Reason 1 body" },
    { "type": "text",         "id": "reason_2_title",   "label": "Reason 2 title", "default": "Desk height is the whole point" },
    { "type": "textarea",     "id": "reason_2_body",    "label": "Reason 2 body" },
    { "type": "text",         "id": "reason_3_title",   "label": "Reason 3 title", "default": "Still hesitant? One pinch of catnip" },
    { "type": "textarea",     "id": "reason_3_body",    "label": "Reason 3 body" },
    { "type": "header",       "content": "Guarantee" },
