<section class="product-section product-section--image-right" id="will-my-cat-use-it" aria-labelledby="s4-heading">
  <div class="product-section__inner">

    <div class="product-section__body">
      <div class="product-section__group">
        <p class="text-subtitle">{{ section.settings.eyebrow | default: "The #1 question we get" }}</p>
        <h2 class="h2" id="s4-heading">{{ section.settings.heading | default: "Will my cat actually use it?" }}</h2>
        <p class="text-paragraph">
          {{ section.settings.body | default: "Most cats claim it within 24 hours. The deep bowl shape isn&rsquo;t a design choice &mdash; it mimics the enclosed, nest-like hideaways cats instinctively seek. Place it at desk height where your cat already likes to sit. Add a pinch of catnip on day one. Then step back." }}
        </p>
      </div>

      <div class="tip-callout">
        <p class="tip-callout__label">The catnip tip</p>
        <p class="tip-callout__text">{{ section.settings.tip | default: "Sprinkle a small pinch of catnip inside the bowl when you first set it up. It signals familiarity and safety. Most cats investigate within minutes and settle in by end of day. After that, they find their own way back &mdash; every morning." }}</p>
      </div>

      <div class="product-section__group">
        <p class="text-paragraph">
          {{ section.settings.body_2 | default: "And if your cat is the rare exception who doesn&rsquo;t take to it? You have 30 days to return it for a full refund. You keep the bed. We&rsquo;re that confident." }}
        </p>
      </div>

      <div class="guarantee-strip">
        <span class="guarantee-strip__icon">&#x1F6E1;</span>
        <p class="guarantee-strip__text">
          <strong>30-day happy-cat guarantee.</strong> {{ section.settings.guarantee | default: "If your cat snubs it, return it for a full refund &mdash; no questions, no hassle, and you keep the bed." }}
        </p>
      </div>

      <div class="product-section__cta">
        <a href="{{ section.settings.cta_url | default: '/products/deskpaws-cat-bed' }}" class="btn btn--secondary">
          {{ section.settings.cta_label | default: "Try It Risk-Free" }}
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
        </a>
      </div>
    </div>

    <div class="product-section__gallery">
      <div class="product-section__slides" id="s4-slides">
        <div class="product-section__slide">
          {%- if section.settings.image_1 -%}
            {{ section.settings.image_1 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_1.alt | default: 'Cat settled in DeskPaws' }}
          {%- else -%}
            <img src="{{ 'cat-curled.png' | asset_url }}" alt="Cat curled and settled in DeskPaws desk bed" width="720" height="740" loading="lazy">
          {%- endif -%}
        </div>
        <div class="product-section__slide">
          {%- if section.settings.image_2 -%}
            {{ section.settings.image_2 | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_2.alt | default: 'DeskPaws top-down view' }}
          {%- else -%}
            <img src="{{ 'product-topdown.png' | asset_url }}" alt="DeskPaws top-down view showing the deep nest shape" width="720" height="740" loading="lazy">
          {%- endif -%}
        </div>
      </div>
      <div class="product-section__controls" aria-label="Gallery navigation">
        <button class="btn-arrow btn-arrow--left" data-slides="s4-slides" data-dir="-1" aria-label="Previous image">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
        </button>
        <button class="btn-arrow" data-slides="s4-slides" data-dir="1" aria-label="Next image">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12" fill="none" aria-hidden="true"><path d="M19.6293 4.46929C15.1122 2.22992 14.0195 0 14.0195 0V5.05512H0V6.94488H14.0098V12H14.0195C14.0195 12 15.1122 9.75118 19.6293 7.52126C21.0732 6.80315 22.5561 6.33071 24 6C22.5561 5.66929 21.0732 5.19685 19.6293 4.47874V4.46929Z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "4 — Will My Cat Use It?",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image_1",         "label": "Gallery image 1" },
    { "type": "image_picker", "id": "image_2",         "label": "Gallery image 2" },
    { "type": "text",     "id": "eyebrow",             "label": "Eyebrow",    "default": "The #1 question we get" },
    { "type": "text",     "id": "heading",             "label": "Heading",    "default": "Will my cat actually use it?" },
    { "type": "textarea", "id": "body",                "label": "Body paragraph 1" },
    { "type": "textarea", "id": "tip",                 "label": "Catnip tip text" },
    { "type": "textarea", "id": "body_2",              "label": "Body paragraph 2" },
    { "type": "textarea", "id": "guarantee",           "label": "Guarantee text" },
    { "type": "text",     "id": "cta_label",           "label": "CTA text",   "default": "Try It Risk-Free" },
    { "type": "url",      "id": "cta_url",             "label": "CTA link" }
  ],
  "presets": [{ "name": "Will My Cat Use It?" }]
}
{% endschema %}
