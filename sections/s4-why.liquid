{%- comment -%}
  Will My Cat Use It? — "The Claimed Spots Wall"
  An editorial registry of real cats that assembles itself on scroll.
  Cats are added as section blocks (photo / name / role / caption).
{%- endcomment -%}

<section class="cw" id="will-my-cat-use-it">

  <div class="cw__head">
    <div class="cw__head-lead reveal">
      <span class="cw__eyebrow">{{ section.settings.eyebrow | default: "Will they actually use it?" }}</span>
      <h2 class="cw__title">{{ section.settings.heading | default: "Meet the cats who claimed their spot." }}</h2>
    </div>
    <p class="cw__intro reveal" style="--reveal-delay:.1s">{{ section.settings.intro | default: "Cats are drawn to height, warmth, and you — and DeskPaws offers all three: a soft, enclosed nest at desk level, right where they already want to be." }}</p>
  </div>

  {%- if section.blocks.size > 0 -%}

    <div class="cw__meta reveal" style="--reveal-delay:.16s">
      <span class="cw__meta-label">{{ section.settings.registry_label | default: "The DeskPaws Registry" }}</span>
      <span class="cw__meta-line" aria-hidden="true"></span>
      <span class="cw__meta-count">{{ section.blocks.size }} claimed</span>
    </div>

    <div class="cw__wall reveal">
      {%- for block in section.blocks -%}
        {%- assign cat_name = block.settings.name | default: "Cat" -%}
        <article class="cw__card" style="--i:{{ forloop.index0 }};--rot:{% cycle 'rot': '-2.5deg','2deg','-1.5deg','2.5deg','-3deg','1.5deg','-2deg','3deg' %}" {{ block.shopify_attributes }}>
          <div class="cw__frame">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'cw__img', alt: cat_name }}
            {%- else -%}
              <span class="cw__mono" aria-hidden="true">{{ cat_name | slice: 0 | upcase }}</span>
            {%- endif -%}

            <span class="cw__seal" aria-hidden="true">
              <span class="cw__seal-top">Spot</span>
              <span class="cw__seal-bot">Claimed</span>
            </span>

            <div class="cw__plate">
              <span class="cw__name">{{ cat_name }}</span>
              {%- if block.settings.role != blank -%}<span class="cw__role">{{ block.settings.role }}</span>{%- endif -%}
              {%- if block.settings.caption != blank -%}<p class="cw__caption">{{ block.settings.caption }}</p>{%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>

  {%- else -%}
    <p class="cw__empty reveal">Add a cat in the theme editor to start the registry.</p>
  {%- endif -%}

  <div class="cw__foot">
    {%- if section.settings.tip != blank -%}
      <p class="cw__tip reveal">{{ section.settings.tip }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '/products/desk-paws-place-for-your-cat-co-worker' }}" class="btn-benefits-cta cw__cta reveal" data-buy-drawer>
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "4 — Claimed Spots Wall",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text",     "id": "eyebrow", "label": "Eyebrow", "default": "Will they actually use it?" },
    { "type": "text",     "id": "heading", "label": "Heading", "default": "Meet the cats who claimed their spot." },
    { "type": "textarea", "id": "intro",   "label": "Intro",   "default": "Cats are drawn to height, warmth, and you — and DeskPaws offers all three: a soft, enclosed nest at desk level, right where they already want to be." },
    { "type": "text",     "id": "registry_label", "label": "Registry label", "default": "The DeskPaws Registry" },
    { "type": "textarea", "id": "tip",     "label": "Reassurance tip", "default": "New to it? A familiar blanket or a pinch of catnip on day one is usually all it takes." },
    { "type": "text",     "id": "cta_label", "label": "CTA text", "default": "Give Them Their Spot — $79" },
    { "type": "url",      "id": "cta_url",   "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "cat",
      "name": "Cat",
      "settings": [
        { "type": "image_picker", "id": "image",   "label": "Cat photo (portrait, ~4:5 works best)" },
        { "type": "text",         "id": "name",    "label": "Cat name",        "default": "Biscuit" },
        { "type": "text",         "id": "role",    "label": "Role / subtitle", "default": "Meeting supervisor" },
        { "type": "textarea",     "id": "caption", "label": "Caption / quote (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Claimed Spots Wall",
      "blocks": [
        { "type": "cat", "settings": { "name": "Biscuit", "role": "Meeting supervisor", "caption": "Attends every call. Contributes nothing. Beloved regardless." } },
        { "type": "cat", "settings": { "name": "Luna",    "role": "Chief nap officer",  "caption": "Clocked in before me. Hasn't clocked out since." } },
        { "type": "cat", "settings": { "name": "Mochi",   "role": "Senior loaf",        "caption": "Perfected the art of being nearby and entirely unbothered." } },
        { "type": "cat", "settings": { "name": "Pepper",  "role": "Keyboard retiree",   "caption": "Twelve years on the keys. Now happily off the clock." } },
        { "type": "cat", "settings": { "name": "Gus",     "role": "Window analyst",     "caption": "Monitors the birds. Reports back rarely." } },
        { "type": "cat", "settings": { "name": "Noodle",  "role": "Head of morale",     "caption": "Purrs through deadlines. Surprisingly effective." } }
      ]
    }
  ]
}
{% endschema %}
